{% schema %}
{
  "name": "Testimonios",
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonio",
      "settings": [
        {
          "type": "range",
          "id": "stars",
          "min": 1,
          "max": 5,
          "step": 1,
          "label": "Estrellas",
          "default": 5
        },
        {
          "type": "textarea",
          "id": "quote",
          "label": "Cita (de una persona real)",
          "default": "",
          "info": "Sin cita, el bloque no se muestra. No rellenes esto con ejemplos: una reseña inventada es sancionable en Canadá, la UE y Estados Unidos, y no compensa nunca."
        },
        {
          "type": "image_picker",
          "id": "avatar",
          "label": "Foto"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Nombre",
          "default": ""
        },
        {
          "type": "text",
          "id": "role",
          "label": "Rol",
          "default": ""
        }
      ]
    }
  ]
}
{% endschema %}
