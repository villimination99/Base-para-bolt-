{%- assign marca = settings.brand_display_name | default: shop.name -%}
{% layout 'password' %}
<section class="password-page">
  <div class="password-inner">
    <div class="password-logo">
      {%- if settings.logo != blank -%}
        <img src="{{ settings.logo | image_url: width: 200 }}" alt="{{ marca | escape }}" width="120" height="120" loading="eager" decoding="async">
      {%- else -%}
        {%- render 'logo-mark' -%}
      {%- endif -%}
    </div>
    <h1 class="password-title">{{ marca }}</h1>
    {%- capture cx_lema -%}{%- render 'copia', g: 'marca', b: 'tienda', a: 'lema', v: settings.brand_tagline -%}{%- endcapture -%}
    {%- if cx_lema != blank -%}<p class="password-tagline">{{ cx_lema }}</p>{%- endif -%}

    {%- if shop.password_message != blank -%}
      <div class="password-message rte">{{ shop.password_message }}</div>
    {%- endif -%}

    {%- form 'storefront_password', class: 'password-form' -%}
      {{ form.errors | default_errors }}
      <label for="Password" class="visually-hidden">{{ 'general.password_page.password_label' | t | default: 'Password' }}</label>
      <input type="password" name="password" id="Password" autocomplete="current-password" placeholder="Contraseña" required>
      <button type="submit" class="btn btn-primary btn-lg">Entrar</button>
    {%- endform -%}

    <p class="password-owner">{{ 'general.password_page.admin_link_html' | t | default: 'Are you the store owner?' }} <a href="/admin">Log in</a></p>
  </div>
</section>
