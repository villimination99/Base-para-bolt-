<section class="section-padding customer-page">
  <div class="container container--xnarrow">
    <h1 class="section-title">{{ 'customer.activate_account.title' | t }}</h1>
    {%- form 'activate_customer_password', class: 'customer-form' -%}
      {{ form.errors | default_errors }}
      <label for="ActPassword">{{ 'customer.activate_account.password' | t }}</label>
      <input type="password" name="customer[password]" id="ActPassword" autocomplete="new-password">
      <label for="ActConfirm">{{ 'customer.activate_account.password_confirm' | t }}</label>
      <input type="password" name="customer[password_confirmation]" id="ActConfirm" autocomplete="new-password">
      <button type="submit" class="btn btn-primary btn-block">{{ 'customer.activate_account.submit' | t }}</button>
      <button type="submit" name="decline" class="btn btn-outline btn-block">{{ 'customer.activate_account.decline' | t }}</button>
    {%- endform -%}
  </div>
</section>
