<section class="section-padding customer-page">
  <div class="container container--xnarrow">
    <h1 class="section-title">{{ 'customer.register.title' | t }}</h1>
    {%- form 'create_customer', class: 'customer-form' -%}
      {{ form.errors | default_errors }}
      <label for="FirstName">{{ 'customer.register.first_name' | t }}</label>
      <input type="text" name="customer[first_name]" id="FirstName" autocomplete="given-name">
      <label for="LastName">{{ 'customer.register.last_name' | t }}</label>
      <input type="text" name="customer[last_name]" id="LastName" autocomplete="family-name">
      <label for="RegEmail">{{ 'customer.register.email' | t }}</label>
      <input type="email" name="customer[email]" id="RegEmail" autocomplete="email" required>
      <label for="RegPassword">{{ 'customer.register.password' | t }}</label>
      <input type="password" name="customer[password]" id="RegPassword" autocomplete="new-password" required>
      <button type="submit" class="btn btn-primary btn-lg btn-block">{{ 'customer.register.submit' | t }}</button>
    {%- endform -%}
    <p class="customer-alt">{{ 'customer.register.has_account' | t }} <a href="{{ routes.account_login_url }}" class="customer-link">{{ 'customer.login.title' | t }}</a></p>
  </div>
</section>
