<section class="section-padding customer-page">
  <div class="container container--xnarrow">
    <h1 class="section-title">{{ 'customer.reset_password.title' | t }}</h1>
    {%- form 'reset_customer_password', class: 'customer-form' -%}
      {{ form.errors | default_errors }}
      <label for="ResetPassword">{{ 'customer.reset_password.password' | t }}</label>
      <input type="password" name="customer[password]" id="ResetPassword" autocomplete="new-password">
      <label for="ResetConfirm">{{ 'customer.reset_password.password_confirm' | t }}</label>
      <input type="password" name="customer[password_confirmation]" id="ResetConfirm" autocomplete="new-password">
      <button type="submit" class="btn btn-primary btn-block">{{ 'customer.reset_password.submit' | t }}</button>
    {%- endform -%}
  </div>
</section>
