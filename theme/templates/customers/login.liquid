<section class="section-padding customer-page">
  <div class="container container--xnarrow">
    <h1 class="section-title">{{ 'customer.login.title' | t }}</h1>
    {%- form 'customer_login', class: 'customer-form' -%}
      {{ form.errors | default_errors }}
      <label for="CustomerEmail">{{ 'customer.login.email' | t }}</label>
      <input type="email" name="customer[email]" id="CustomerEmail" autocomplete="email" required>
      {%- if form.password_needed -%}
        <label for="CustomerPassword">{{ 'customer.login.password' | t }}</label>
        <input type="password" name="customer[password]" id="CustomerPassword" autocomplete="current-password" required>
        <a href="#recover" class="customer-link" onclick="document.getElementById('RecoverForm').hidden=false;return false;">{{ 'customer.login.forgot_password' | t }}</a>
      {%- endif -%}
      <button type="submit" class="btn btn-primary btn-lg btn-block">{{ 'customer.login.sign_in' | t }}</button>
    {%- endform -%}
    <div id="RecoverForm" hidden class="customer-recover">
      {%- form 'recover_customer_password', class: 'customer-form' -%}
        {{ form.errors | default_errors }}
        {%- if form.posted_successfully? -%}<p class="form-success">{{ 'customer.recover_password.success' | t }}</p>{%- endif -%}
        <label for="RecoverEmail">{{ 'customer.recover_password.email' | t }}</label>
        <input type="email" name="email" id="RecoverEmail" autocomplete="email" required>
        <button type="submit" class="btn btn-outline btn-block">{{ 'customer.recover_password.submit' | t }}</button>
      {%- endform -%}
    </div>
    <p class="customer-alt">{{ 'customer.login.no_account' | t }} <a href="{{ routes.account_register_url }}" class="customer-link">{{ 'customer.register.title' | t }}</a></p>
  </div>
</section>
