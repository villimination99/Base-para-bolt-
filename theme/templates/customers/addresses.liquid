<section class="section-padding customer-page">
  <div class="container container--narrow">
    <h1 class="section-title">{{ 'customer.addresses.title' | t }}</h1>
    <a href="{{ routes.account_url }}" class="customer-link">&larr; {{ 'customer.account.return' | t }}</a>

    {%- form 'customer_address', customer.new_address, class: 'customer-form' -%}
      <h2>{{ 'customer.addresses.add_new' | t }}</h2>

      {%- comment -%}
        Sin esto, si Shopify rechaza la dirección (falta el país, código postal inválido…)
        el formulario se recarga en silencio y el cliente no sabe qué corregir.
      {%- endcomment -%}
      {%- if form.errors -%}
        <div class="form-errors" role="alert">
          <ul>
            {%- for field in form.errors -%}
              <li>{{ form.errors.messages[field] }}</li>
            {%- endfor -%}
          </ul>
        </div>
      {%- endif -%}

      <input type="text" name="address[first_name]" autocomplete="given-name" required
             placeholder="{{ 'customer.addresses.first_name' | t }}" aria-label="{{ 'customer.addresses.first_name' | t }}">
      <input type="text" name="address[last_name]" autocomplete="family-name" required
             placeholder="{{ 'customer.addresses.last_name' | t }}" aria-label="{{ 'customer.addresses.last_name' | t }}">
      <input type="text" name="address[address1]" autocomplete="address-line1" required
             placeholder="{{ 'customer.addresses.address1' | t }}" aria-label="{{ 'customer.addresses.address1' | t }}">
      <input type="text" name="address[city]" autocomplete="address-level2" required
             placeholder="{{ 'customer.addresses.city' | t }}" aria-label="{{ 'customer.addresses.city' | t }}">

      {%- comment -%} País y provincia faltaban: Shopify los necesita para calcular envío e impuestos. {%- endcomment -%}
      <select name="address[country]" id="AddressCountryNew" autocomplete="country" aria-label="{{ 'customer.addresses.country' | t }}" required>
        {{ country_option_tags }}
      </select>
      <input type="text" name="address[province]" autocomplete="address-level1"
             placeholder="{{ 'customer.addresses.province' | t }}" aria-label="{{ 'customer.addresses.province' | t }}">

      <input type="text" name="address[zip]" autocomplete="postal-code" inputmode="numeric" required
             placeholder="{{ 'customer.addresses.zip' | t }}" aria-label="{{ 'customer.addresses.zip' | t }}">
      <input type="tel" name="address[phone]" autocomplete="tel" inputmode="tel"
             placeholder="{{ 'customer.addresses.phone' | t }}" aria-label="{{ 'customer.addresses.phone' | t }}">

      <button type="submit" class="btn btn-primary btn-block">{{ 'customer.addresses.add' | t }}</button>
    {%- endform -%}

    {%- for address in customer.addresses -%}
      <div class="address-card">
        {{ address | format_address }}
        <a href="{{ address.url }}" class="customer-link">{{ 'customer.addresses.edit' | t }}</a>
      </div>
    {%- endfor -%}
  </div>
</section>
