<!doctype html>
<html lang="{{ request.locale.iso_code }}" class="{% if settings.accessibility_mode %}a11y-mode{% endif %}">
<head>
  <meta charset="utf-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="theme-color" content="{{ settings.color_bg }}">
  <link rel="canonical" href="{{ canonical_url }}">

  {%- if settings.favicon != blank -%}
    <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
  {%- endif -%}

  <title>{{ page_title }}{% if current_tags %} &ndash; {{ 'general.meta.tags' | t: tags: current_tags | join: ', ' }}{% endif %}{% if current_page != 1 %} &ndash; {{ 'general.meta.page' | t: page: current_page }}{% endif %}{% unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless %}</title>

  {%- if page_description -%}
    <meta name="description" content="{{ page_description | escape }}">
  {%- endif -%}

  {%- comment -%} SEO social + hreflang (incrustado a propósito: sin dependencia de snippets) {%- endcomment -%}
{%- comment -%}
  Open Graph + Twitter Cards. Controla cómo se ve tu tienda al compartirla en
  WhatsApp, Instagram, Facebook, X, Discord… y ayuda a los rastreadores a entenderla.
{%- endcomment -%}
{%- liquid
  assign og_title = page_title
  assign og_desc = page_description | default: shop.description | default: shop.name
  assign og_type = 'website'
  assign og_image = null

  case request.page_type
    when 'product'
      assign og_type = 'product'
      assign og_image = product.featured_media.preview_image
    when 'article'
      assign og_type = 'article'
      assign og_image = article.image
    when 'collection'
      assign og_image = collection.image
  endcase

  if og_image == null and settings.logo != blank
    assign og_image = settings.logo
  endif
-%}
<meta property="og:site_name" content="{{ shop.name | escape }}">
<meta property="og:url" content="{{ canonical_url }}">
<meta property="og:title" content="{{ og_title | escape }}">
<meta property="og:type" content="{{ og_type }}">
<meta property="og:description" content="{{ og_desc | strip_html | truncate: 200 | escape }}">
{%- if og_image -%}
  <meta property="og:image" content="http:{{ og_image | image_url: width: 1200 }}">
  <meta property="og:image:secure_url" content="https:{{ og_image | image_url: width: 1200 }}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="{{ 1200 | divided_by: og_image.aspect_ratio | round }}">
  <meta property="og:image:alt" content="{{ og_image.alt | default: og_title | escape }}">
{%- endif -%}
{%- if request.page_type == 'product' -%}
  <meta property="product:price:amount" content="{{ product.selected_or_first_available_variant.price | divided_by: 100.0 }}">
  <meta property="product:price:currency" content="{{ cart.currency.iso_code }}">
  <meta property="product:availability" content="{% if product.available %}in stock{% else %}out of stock{% endif %}">
{%- endif -%}

<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ og_title | escape }}">
<meta name="twitter:description" content="{{ og_desc | strip_html | truncate: 200 | escape }}">
{%- if og_image -%}
  <meta name="twitter:image" content="https:{{ og_image | image_url: width: 1200 }}">
{%- endif -%}

{%- comment -%}
  hreflang: le dice a Google que estas páginas son la MISMA página en otro idioma.
  Sin esto, las versiones traducidas compiten entre sí como contenido duplicado.
{%- endcomment -%}
{%- if localization.available_languages.size > 1 -%}
  {%- liquid
    assign cur_root = request.locale.root_url
    assign bare_path = request.path
    unless cur_root == '/'
      assign bare_path = bare_path | remove_first: cur_root
    endunless
  -%}
  {%- for lang in localization.available_languages -%}
    {%- liquid
      assign lang_root = lang.root_url
      if lang_root == '/'
        assign alt_path = bare_path
      else
        assign alt_path = lang_root | append: bare_path
      endif
    -%}
    <link rel="alternate" hreflang="{{ lang.iso_code }}" href="{{ shop.url }}{{ alt_path }}">
    {%- if lang.primary -%}
      <link rel="alternate" hreflang="x-default" href="{{ shop.url }}{{ alt_path }}">
    {%- endif -%}
  {%- endfor -%}
{%- endif -%}

  {%- comment -%} Brand display font (Orbitron) — kept for the neon identity {%- endcomment -%}
  {%- if settings.use_display_font -%}
    <link rel="preconnect" href="https://fonts.googleapis.com" crossorigin>
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Orbitron:wght@500;700;900&display=swap" media="print" onload="this.media='all'">
    <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Orbitron:wght@500;700;900&display=swap"></noscript>
  {%- endif -%}

  {%- comment -%} Acelera miniaturas de video (YouTube) sin bloquear el render {%- endcomment -%}
  <link rel="preconnect" href="https://i.ytimg.com" crossorigin>
  <link rel="dns-prefetch" href="https://www.youtube.com">

  {%- assign body_font = settings.font_body -%}
  {%- assign heading_font = settings.font_heading -%}
  {%- style -%}
    {{ body_font | font_face: font_display: 'swap' }}
    {{ heading_font | font_face: font_display: 'swap' }}
    {%- if settings.font_body_scale != 100 -%}
      html { font-size: {{ settings.font_body_scale | times: 0.16 }}px; }
    {%- endif -%}

    :root {
      /* Sistema neón configurable: color por sección (--sec-neon), velocidad e intensidad globales */
      --neon-speed: {{ settings.neon_speed | default: 6 }}s;
      --neon-int: {{ settings.neon_intensity | default: 60 | divided_by: 100.0 }};
      /* Fotos de producto: ajuste y aire configurables desde el editor */
      --pimg-fit: {{ settings.product_img_fit | default: 'contain' }};
      --pimg-pad: {{ settings.product_img_pad | default: 6 }}%;
      --neon-cyan: {{ settings.color_cyan }};
      --neon-blue: #0077ff;
      --neon-pink: {{ settings.color_pink }};
      --neon-green: {{ settings.color_green }};
      --neon-orange: {{ settings.color_orange }};
      --neon-yellow: #ffd000;
      --neon-purple: {{ settings.color_purple }};
      --color-bg: {{ settings.color_bg }};
      --color-surface: {{ settings.color_surface }};
      --color-text: {{ settings.color_text }};
      --dark-950: {{ settings.color_bg }};
      --dark-900: {{ settings.color_surface }};
      --font-body: {{ body_font.family }}, {{ body_font.fallback_families }};
      --font-body-weight: {{ body_font.weight }};
      --font-heading: {% if settings.use_display_font %}'Orbitron', {% endif %}{{ heading_font.family }}, {{ heading_font.fallback_families }};
      /* Diseño configurable desde el editor */
      --page-width: {{ settings.page_width | default: 1280 }}px;
      --section-space: {{ settings.section_spacing | default: 96 }}px;
      --grid-gap: {{ settings.grid_gap | default: 28 }}px;
      --card-radius: {{ settings.card_radius | default: 18 }}px;
      --btn-radius: {{ settings.button_radius | default: 12 }}px;
      --btn-border: {{ settings.button_border | default: 1 }}px;
      --badge-radius: {{ settings.badge_radius | default: 10 }}px;
      --input-radius: {{ settings.input_radius | default: 10 }}px;
      --input-border: {{ settings.input_border_opacity | default: 30 | divided_by: 100.0 }};
      --drawer-width: {{ settings.drawer_width | default: 400 }}px;
      --overlay-alpha: {{ settings.overlay_opacity | default: 80 | divided_by: 100.0 }};
      --overlay-blur: {{ settings.overlay_blur | default: 8 }}px;
      --icon-stroke: {{ settings.icon_stroke | default: 2 }};
      --heading-spacing: {{ settings.heading_spacing | default: 2 | divided_by: 100.0 }}em;
      --price-size: {{ settings.price_size | default: 100 | divided_by: 100.0 }};
      --color-sale: {{ settings.color_sale | default: '#ff2ecb' }};
      --color-star: {{ settings.color_star | default: '#ffd000' }};
    }
    body { background: var(--color-bg); color: var(--color-text); font-family: var(--font-body); }
  {%- endstyle -%}

  {{ 'villumination.css' | asset_url | stylesheet_tag }}

  {%- comment -%} Aplica las variables de diseño del editor sobre el CSS del tema {%- endcomment -%}
  {%- style -%}
    .container:not(.container--narrow):not(.container--xnarrow) { max-width: var(--page-width); }
    .section-padding { padding-top: var(--section-space); padding-bottom: var(--section-space); }
    @media (max-width: 749px) {
      .section-padding { padding-top: calc(var(--section-space) * .58); padding-bottom: calc(var(--section-space) * .58); }
    }
    .product-card, .col-index-tile, .cc-item, .fp-stage, .catgrid-card { border-radius: var(--card-radius); }
    .product-grid, .col-index-grid { gap: var(--grid-gap); }
    .btn { border-radius: var(--btn-radius); border-width: var(--btn-border); {% unless settings.button_uppercase %}text-transform: none; letter-spacing: .02em;{% endunless %} }
    {%- unless settings.button_glow %}.btn:hover { box-shadow: none !important; }{% endunless -%}
    .product-card-badge, .pcb-sale, .pcb-low, .pcb-new { border-radius: var(--badge-radius); }
    input[type="text"], input[type="email"], input[type="search"], input[type="password"], input[type="number"], input[type="tel"], select, textarea { border-radius: var(--input-radius); border-color: rgba(0,212,255,var(--input-border)); }
    .cart-drawer-panel { width: var(--drawer-width); max-width: 92vw; }
    .cart-drawer-overlay, .mobile-menu-overlay { background: rgba(5,5,16,var(--overlay-alpha)); {% if settings.overlay_blur > 0 %}-webkit-backdrop-filter: blur(var(--overlay-blur)); backdrop-filter: blur(var(--overlay-blur));{% else %}-webkit-backdrop-filter:none; backdrop-filter:none;{% endif %} }
    .icon, .product-trust svg, .nav-icon-btn svg { stroke-width: var(--icon-stroke); }
    h1, h2, h3, .section-title, .product-title, .hero-title { letter-spacing: var(--heading-spacing); }
    .product-price-amount { font-size: calc(1em * var(--price-size)); }
    .product-price-compare { color: var(--color-sale); }
    .product-stars .star.is-on { color: var(--color-star); }
    {%- unless settings.price_show_compare %}.product-price-compare { display: none; }{% endunless -%}
    {%- unless settings.price_show_save %}.product-save-line, .product-save-badge { display: none !important; }{% endunless -%}
    {%- if settings.card_text_align == 'center' %}.product-card-body { text-align: center; } .product-card-footer { justify-content: center; }{% endif -%}
    {%- unless settings.search_show_header %}[data-search-toggle], .search-panel { display: none !important; }{% endunless -%}
    {%- if settings.variant_style == 'square' %}.product-option-value { border-radius: 6px; }{% endif -%}
    {%- if settings.custom_css != blank -%}
      {{ settings.custom_css }}
    {%- endif -%}
  {%- endstyle -%}

  <noscript><style>#splash-intro{display:none!important}[data-reveal]{opacity:1!important}</style></noscript>

  <script>
    window.theme = {
      routes: {
        cart: "{{ routes.cart_url }}",
        cartAdd: "{{ routes.cart_add_url }}",
        cartChange: "{{ routes.cart_change_url }}",
        cartUpdate: "{{ routes.cart_update_url }}",
        search: "{{ routes.search_url }}",
        predictiveSearch: "{{ routes.predictive_search_url }}"
      },
      settings: {
        cartType: "{{ settings.cart_type }}",
        seasonalEffect: "{{ settings.seasonal_effect }}",
        seasonalDensity: {{ settings.seasonal_density | default: 50 }},
        parallax: {{ settings.enable_parallax | default: false }},
        scrollReveal: {{ settings.enable_scroll_reveal | default: false }},
        cardTilt: {{ settings.enable_card_tilt | default: false }},
        splash3d: {{ settings.splash_3d | default: false }},
        splashOnce: {{ settings.splash_once_per_session | default: true }},
        autoLang: {{ settings.auto_language | default: false }},
        locale: {{ request.locale.iso_code | json }},
        ambient: {{ settings.ambient_bg | default: 'full' | json }},
        cursorGlow: {{ settings.cursor_glow | default: false }},
        moneyFormat: {{ shop.money_format | json }}
      },
      strings: {
        addToCart: {{ 'products.product.add_to_cart' | t | json }},
        soldOut: {{ 'products.product.sold_out' | t | json }},
        subtotal: {{ 'cart.general.subtotal' | t | json }},
        checkout: {{ 'cart.general.checkout' | t | json }},
        viewCart: {{ 'cart.general.view_cart' | t | json }},
        cartEmpty: {{ 'cart.general.empty' | t | json }},
        shop: {{ 'general.shop' | t | json }},
        noResults: {{ 'general.search.no_results_short' | t | json }},
        viewAll: {{ 'general.search.view_all' | t | json }}
      }
    };
  </script>

  {%- comment -%} Datos estructurados JSON-LD (incrustado a propósito) {%- endcomment -%}
{%- comment -%}
  Datos estructurados (JSON-LD schema.org). Es lo que leen Google (resultados
  enriquecidos: precio, stock, estrellas) y los rastreadores de IA para entender
  qué vendes. Sin esto, tu tienda es "invisible" para ellos.
{%- endcomment -%}

{%- comment -%} Organización + buscador del sitio (en todas las páginas) {%- endcomment -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": {{ shop.name | json }},
  "url": {{ shop.url | json }}
  {%- if settings.logo != blank -%},
  "logo": {{ settings.logo | image_url: width: 512 | prepend: 'https:' | json }}
  {%- endif -%}
  {%- if shop.description != blank -%},
  "description": {{ shop.description | strip_html | json }}
  {%- endif -%}
  {%- assign socials = '' -%}
  {%- if settings.social_youtube != blank -%}{%- assign socials = socials | append: settings.social_youtube | append: '|' -%}{%- endif -%}
  {%- if settings.social_instagram != blank -%}{%- assign socials = socials | append: settings.social_instagram | append: '|' -%}{%- endif -%}
  {%- if settings.social_tiktok != blank -%}{%- assign socials = socials | append: settings.social_tiktok | append: '|' -%}{%- endif -%}
  {%- if settings.social_x != blank -%}{%- assign socials = socials | append: settings.social_x | append: '|' -%}{%- endif -%}
  {%- assign social_list = socials | split: '|' -%}
  {%- if social_list.size > 0 -%},
  "sameAs": {{ social_list | json }}
  {%- endif -%}
}
</script>

{%- if request.page_type == 'index' -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": {{ shop.name | json }},
  "url": {{ shop.url | json }},
  "potentialAction": {
    "@type": "SearchAction",
    "target": {{ shop.url | append: routes.search_url | append: '?q={search_term_string}' | json }},
    "query-input": "required name=search_term_string"
  }
}
</script>
{%- endif -%}

{%- if request.page_type == 'product' -%}
  {%- liquid
    assign pv = product.selected_or_first_available_variant
    assign p_desc = product.description | default: product.title | strip_html | truncate: 500
  -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Product",
  "name": {{ product.title | json }},
  "url": {{ shop.url | append: product.url | json }},
  "description": {{ p_desc | json }},
  {%- if product.images.size > 0 -%}
  "image": [
    {%- for image in product.images limit: 3 -%}
      {{ image | image_url: width: 1200 | prepend: 'https:' | json }}{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  ],
  {%- endif -%}
  {%- if product.vendor != blank -%}
  "brand": { "@type": "Brand", "name": {{ product.vendor | json }} },
  {%- endif -%}
  {%- if pv.sku != blank -%}
  "sku": {{ pv.sku | json }},
  {%- endif -%}
  {%- assign r_mf = product.metafields.reviews.rating -%}
  {%- if r_mf != blank and r_mf.value != blank and product.metafields.reviews.rating_count.value > 0 -%}
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": {{ r_mf.value.rating | json }},
    "ratingCount": {{ product.metafields.reviews.rating_count.value | json }},
    "bestRating": {{ r_mf.value.scale_max | default: 5 | json }}
  },
  {%- endif -%}
  "offers": {
    "@type": "Offer",
    "url": {{ shop.url | append: product.url | json }},
    "price": {{ pv.price | divided_by: 100.0 | json }},
    "priceCurrency": {{ cart.currency.iso_code | json }},
    "availability": {% if product.available %}"https://schema.org/InStock"{% else %}"https://schema.org/OutOfStock"{% endif %},
    "itemCondition": "https://schema.org/NewCondition"
  }
}
</script>
{%- endif -%}

{%- if request.page_type == 'article' -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": {{ article.title | json }},
  "url": {{ shop.url | append: article.url | json }},
  "datePublished": {{ article.published_at | date: '%Y-%m-%dT%H:%M:%SZ' | json }},
  "author": { "@type": "Person", "name": {{ article.author | json }} },
  "publisher": { "@type": "Organization", "name": {{ shop.name | json }} }
  {%- if article.image -%},
  "image": {{ article.image | image_url: width: 1200 | prepend: 'https:' | json }}
  {%- endif -%}
}
</script>
{%- endif -%}

{%- comment -%} Migas de pan: ayudan a Google a mostrar la ruta en los resultados {%- endcomment -%}
{%- if request.page_type == 'product' or request.page_type == 'collection' -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": {{ 'general.home' | t | json }}, "item": {{ shop.url | json }} }
    {%- if request.page_type == 'collection' -%},
    { "@type": "ListItem", "position": 2, "name": {{ collection.title | json }}, "item": {{ shop.url | append: collection.url | json }} }
    {%- elsif request.page_type == 'product' -%}
      {%- if product.collections.first -%},
      { "@type": "ListItem", "position": 2, "name": {{ product.collections.first.title | json }}, "item": {{ shop.url | append: product.collections.first.url | json }} },
      { "@type": "ListItem", "position": 3, "name": {{ product.title | json }}, "item": {{ shop.url | append: product.url | json }} }
      {%- else -%},
      { "@type": "ListItem", "position": 2, "name": {{ product.title | json }}, "item": {{ shop.url | append: product.url | json }} }
      {%- endif -%}
    {%- endif -%}
  ]
}
</script>
{%- endif -%}

  {{ content_for_header }}
</head>

<body class="grid-bg template-{{ template.name | handle }} pcard-{{ settings.product_card_style | default: 'float' }}{% if settings.product_img_glow %} pimg-glow{% endif %}{% if settings.product_img_blend %} pimg-blend{% endif %}">

  <a class="skip-to-content" href="#MainContent">{{ 'accessibility.skip_to_content' | t }}</a>

  {%- liquid
    assign show_splash = false
    if settings.splash_enabled
      if settings.splash_home_only == false
        assign show_splash = true
      elsif request.page_type == 'index'
        assign show_splash = true
      endif
    endif
  -%}
  {%- if show_splash -%}
    {%- render 'splash-intro' -%}
  {%- endif -%}

  {% sections 'header-group' %}

  <main id="MainContent" role="main" tabindex="-1">
    {{ content_for_layout }}
  </main>

  {% sections 'footer-group' %}

  {%- render 'cart-drawer' -%}

  <button class="back-to-top" data-back-to-top aria-label="{{ 'accessibility.back_to_top' | t | default: 'Volver arriba' }}">{%- render 'icon', name: 'arrow-right' -%}</button>

  <script src="{{ 'base.js' | asset_url }}" defer></script>
  {%- comment -%} effects.js = mejoras visuales progresivas. Se cargan en tiempo libre (idle) para no competir con el primer render → mejor LCP/TTI. {%- endcomment -%}
  <script>
    (function () {
      var src = "{{ 'effects.js' | asset_url }}";
      function load() { var s = document.createElement('script'); s.src = src; s.defer = true; document.body.appendChild(s); }
      if ('requestIdleCallback' in window) { requestIdleCallback(load, { timeout: 2000 }); }
      else { window.addEventListener('load', function () { setTimeout(load, 200); }); }
    })();
  </script>
</body>
</html>
