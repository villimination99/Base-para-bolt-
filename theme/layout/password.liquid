<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="theme-color" content="{{ settings.color_bg }}">
  <title>{{ page_title }}</title>
  {%- if settings.favicon != blank -%}<link rel="icon" type="image/png" sizes="48x48" href="{{ settings.favicon | image_url: width: 48, height: 48, crop: 'center' }}">{%- endif -%}
  {%- style -%}
    :root { --neon-cyan: {{ settings.color_cyan }}; --neon-pink: {{ settings.color_pink }}; --color-bg: {{ settings.color_bg }}; }
    @font-face {
      font-family: 'Orbitron';
      src: url({{ 'orbitron-variable.woff2' | asset_url }}) format('woff2');
      font-weight: 400 900;
      font-style: normal;
      font-display: swap;
    }
  {%- endstyle -%}
  {{ 'villumination.css' | asset_url | stylesheet_tag }}
  {{ content_for_header }}
</head>
<body class="grid-bg template-password">
  <main role="main">{{ content_for_layout }}</main>
</body>
</html>
