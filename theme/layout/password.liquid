<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="theme-color" content="{{ settings.color_bg }}">
  <title>{{ page_title }}</title>
  {%- if settings.favicon != blank -%}<link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32 }}">{%- endif -%}
  {%- style -%}
    :root { --neon-cyan: {{ settings.color_cyan }}; --neon-pink: {{ settings.color_pink }}; --color-bg: {{ settings.color_bg }}; }
  {%- endstyle -%}
  {{ 'villumination.css' | asset_url | stylesheet_tag }}
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Orbitron:wght@700;900&display=swap" media="print" onload="this.media='all'">
  {{ content_for_header }}
</head>
<body class="grid-bg template-password">
  <main role="main">{{ content_for_layout }}</main>
</body>
</html>
