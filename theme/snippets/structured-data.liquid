{%- comment -%}
  Datos estructurados (JSON-LD schema.org). Es lo que leen Google (resultados
  enriquecidos: precio, stock, estrellas) y los rastreadores de IA para entender
  qué vendes. Sin esto, tu tienda es "invisible" para ellos.
{%- endcomment -%}

{%- comment -%} Organización + buscador del sitio (en todas las páginas) {%- endcomment -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": {{ shop.url | append: '#organization' | json }},
  "name": {{ shop.name | json }},
  "url": {{ shop.url | json }}
  {%- comment -%}
    Logo para Google. Exige un mínimo de 112x112 px: si el logo es apaisado, se amplía el
    ancho lo necesario para que la ALTURA también supere ese mínimo, y se declaran las
    dimensiones de forma explícita (ImageObject) para que Google no tenga que deducirlas.
  {%- endcomment -%}
  {%- if settings.logo != blank -%}
    {%- liquid
      assign l_ar = settings.logo.aspect_ratio | default: 1
      assign l_w = 512
      assign min_w = l_ar | times: 140 | round
      if min_w > l_w
        assign l_w = min_w
      endif
      assign l_h = l_w | divided_by: l_ar | round
    -%},
  "logo": {
    "@type": "ImageObject",
    "url": {{ settings.logo | image_url: width: l_w | prepend: 'https:' | json }},
    "width": {{ l_w }},
    "height": {{ l_h }}
  },
  "image": {{ settings.logo | image_url: width: l_w | prepend: 'https:' | json }}
  {%- endif -%}
  {%- if shop.description != blank -%},
  "description": {{ shop.description | strip_html | json }}
  {%- endif -%}
  {%- assign socials = '' -%}
  {%- if settings.social_youtube != blank -%}{%- assign socials = socials | append: settings.social_youtube | append: '|' -%}{%- endif -%}
  {%- if settings.social_instagram != blank -%}{%- assign socials = socials | append: settings.social_instagram | append: '|' -%}{%- endif -%}
  {%- if settings.social_tiktok != blank -%}{%- assign socials = socials | append: settings.social_tiktok | append: '|' -%}{%- endif -%}
  {%- if settings.social_x != blank -%}{%- assign socials = socials | append: settings.social_x | append: '|' -%}{%- endif -%}
  {%- assign social_list = socials | split: '|' -%}
  {%- if social_list.size > 0 -%},
  "sameAs": {{ social_list | json }}
  {%- endif -%}
}
</script>

{%- comment -%}
  WebSite. Sin "potentialAction"/SearchAction a propósito: Google retiró el cuadro de
  búsqueda de enlaces de sitio, así que ya no genera ningún resultado enriquecido, y su
  plantilla obligaba a escribir llaves { } dentro de una etiqueta Liquid — algo que el
  importador de temas de Shopify rechaza, descartando el archivo completo.
{%- endcomment -%}
{%- if request.page_type == 'index' -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": {{ shop.url | append: '#website' | json }},
  "name": {{ shop.name | json }},
  "url": {{ shop.url | json }},
  "publisher": { "@id": {{ shop.url | append: '#organization' | json }} },
  "inLanguage": {{ request.locale.iso_code | json }}
}
</script>
{%- endif -%}

{%- if request.page_type == 'product' -%}
  {%- liquid
    assign pv = product.selected_or_first_available_variant
    assign p_desc = product.description | default: product.title | strip_html | truncate: 500
  -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Product",
  "name": {{ product.title | json }},
  "url": {{ shop.url | append: product.url | json }},
  "description": {{ p_desc | json }},
  {%- if product.images.size > 0 -%}
  "image": [
    {%- for image in product.images limit: 3 -%}
      {{ image | image_url: width: 1200 | prepend: 'https:' | json }}{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  ],
  {%- endif -%}
  {%- if product.vendor != blank -%}
  "brand": { "@type": "Brand", "name": {{ product.vendor | json }} },
  {%- endif -%}
  {%- if pv.sku != blank -%}
  "sku": {{ pv.sku | json }},
  {%- endif -%}
  {%- assign r_mf = product.metafields.reviews.rating -%}
  {%- if r_mf != blank and r_mf.value != blank and product.metafields.reviews.rating_count.value > 0 -%}
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": {{ r_mf.value.rating | json }},
    "ratingCount": {{ product.metafields.reviews.rating_count.value | json }},
    "bestRating": {{ r_mf.value.scale_max | default: 5 | json }}
  },
  {%- endif -%}
  {%- comment -%}
    Con varias variantes a distinto precio, un único Offer le decía a Google un
    solo importe y el resto del abanico quedaba invisible en los resultados.
    AggregateOffer es el tipo que schema.org define justo para eso: declara el
    precio mínimo, el máximo y cuántas ofertas hay.
  {%- endcomment -%}
  {%- if product.price_varies -%}
  "offers": {
    "@type": "AggregateOffer",
    "url": {{ shop.url | append: product.url | json }},
    "lowPrice": {{ product.price_min | divided_by: 100.0 | json }},
    "highPrice": {{ product.price_max | divided_by: 100.0 | json }},
    "offerCount": {{ product.variants.size }},
    "priceCurrency": {{ cart.currency.iso_code | json }},
    "availability": {% if product.available %}"https://schema.org/InStock"{% else %}"https://schema.org/OutOfStock"{% endif %},
    "itemCondition": "https://schema.org/NewCondition",
    "seller": { "@id": {{ shop.url | append: '#organization' | json }} }
  }
  {%- else -%}
  "offers": {
    "@type": "Offer",
    "url": {{ shop.url | append: product.url | json }},
    "price": {{ pv.price | divided_by: 100.0 | json }},
    "priceCurrency": {{ cart.currency.iso_code | json }},
    {%- comment -%} Google avisa si falta priceValidUntil; se proyecta un año vista. {%- endcomment -%}
    "priceValidUntil": {{ 'now' | date: '%s' | plus: 31536000 | date: '%Y-%m-%d' | json }},
    "availability": {% if product.available %}"https://schema.org/InStock"{% else %}"https://schema.org/OutOfStock"{% endif %},
    "itemCondition": "https://schema.org/NewCondition",
    "seller": { "@id": {{ shop.url | append: '#organization' | json }} }
  }
  {%- endif -%}
}
</script>
{%- endif -%}

{%- if request.page_type == 'article' -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": {{ article.title | json }},
  "url": {{ shop.url | append: article.url | json }},
  {%- comment -%}
    La fecha llevaba una "Z" fija al final, que significa UTC, pero Shopify da
    la hora en el huso de la tienda: se estaba declarando una hora falsa, con
    horas de desfase. %z escribe el desplazamiento real. Se añade también
    dateModified, que Google usa para saber si el artículo está actualizado.
  {%- endcomment -%}
  "datePublished": {{ article.published_at | date: '%Y-%m-%dT%H:%M:%S%z' | json }},
  "dateModified": {{ article.updated_at | default: article.published_at | date: '%Y-%m-%dT%H:%M:%S%z' | json }},
  {%- if article.author != blank -%}
  "author": { "@type": "Person", "name": {{ article.author | json }} },
  {%- else -%}
  "author": { "@type": "Organization", "name": {{ shop.name | json }} },
  {%- endif -%}
  {%- comment -%} Se referencia la Organización ya declarada, con su logo, en vez de repetir solo el nombre. {%- endcomment -%}
  "publisher": { "@id": {{ shop.url | append: '#organization' | json }} }
  {%- if article.image -%},
  "image": {{ article.image | image_url: width: 1200 | prepend: 'https:' | json }}
  {%- endif -%}
}
</script>
{%- endif -%}

{%- comment -%}
  Listado de productos de la colección: permite a Google (y a los rastreadores de IA)
  entender qué productos contiene la categoría, no solo el texto de la página.
{%- endcomment -%}
{%- if request.page_type == 'collection' and collection.products.size > 0 -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": {{ collection.title | json }},
  "url": {{ shop.url | append: collection.url | json }},
  {%- comment -%}
    numberOfItems debe describir la lista que se envía, no la colección entera:
    se declaraban cientos de productos y solo se listaban 24.
  {%- endcomment -%}
  {%- assign il_count = collection.products_count -%}
  {%- if il_count > 24 -%}{%- assign il_count = 24 -%}{%- endif -%}
  "numberOfItems": {{ il_count }},
  "itemListElement": [
    {%- for p in collection.products limit: 24 -%}
    {
      "@type": "ListItem",
      "position": {{ forloop.index }},
      "url": {{ shop.url | append: p.url | json }},
      "name": {{ p.title | json }}
    }{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  ]
}
</script>
{%- endif -%}

{%- comment -%} Migas de pan: ayudan a Google a mostrar la ruta en los resultados {%- endcomment -%}
{%- if request.page_type == 'product' or request.page_type == 'collection' -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": {{ 'general.home' | t | json }}, "item": {{ shop.url | json }} }
    {%- if request.page_type == 'collection' -%},
    { "@type": "ListItem", "position": 2, "name": {{ collection.title | json }}, "item": {{ shop.url | append: collection.url | json }} }
    {%- elsif request.page_type == 'product' -%}
      {%- if product.collections.first -%},
      { "@type": "ListItem", "position": 2, "name": {{ product.collections.first.title | json }}, "item": {{ shop.url | append: product.collections.first.url | json }} },
      { "@type": "ListItem", "position": 3, "name": {{ product.title | json }}, "item": {{ shop.url | append: product.url | json }} }
      {%- else -%},
      { "@type": "ListItem", "position": 2, "name": {{ product.title | json }}, "item": {{ shop.url | append: product.url | json }} }
      {%- endif -%}
    {%- endif -%}
  ]
}
</script>
{%- endif -%}
