{%- comment -%} Rendered inside the cart drawer and re-fetched after AJAX cart updates. {%- endcomment -%}
{%- if cart.item_count > 0 -%}
  <ul class="cart-drawer-items" role="list">
    {%- for item in cart.items -%}
      <li class="cart-drawer-item" data-line="{{ forloop.index }}" data-key="{{ item.key }}">
        <a href="{{ item.url }}" class="cart-drawer-item-media">
          {%- if item.image -%}
            <img src="{{ item.image | image_url: width: 160 }}" alt="{{ item.title | escape }}" width="72" height="72" loading="lazy">
          {%- else -%}
            <span class="cart-drawer-item-placeholder">{%- render 'icon', name: 'cube' -%}</span>
          {%- endif -%}
        </a>
        <div class="cart-drawer-item-info">
          <a href="{{ item.url }}" class="cart-drawer-item-title">{{ item.product.title }}</a>
          {%- unless item.variant.title contains 'Default' -%}
            <p class="cart-drawer-item-variant">{{ item.variant.title }}</p>
          {%- endunless -%}
          <div class="cart-drawer-qty" data-qty>
            <button type="button" data-qty-down aria-label="{{ 'products.product.decrease' | t }}">&minus;</button>
            <input type="number" value="{{ item.quantity }}" min="0" aria-label="{{ 'products.product.quantity' | t }}" data-qty-input data-key="{{ item.key }}">
            <button type="button" data-qty-up aria-label="{{ 'products.product.increase' | t }}">&plus;</button>
          </div>
        </div>
        <div class="cart-drawer-item-right">
          <span class="cart-drawer-item-price">{{ item.final_line_price | money }}</span>
          <button type="button" class="cart-drawer-item-remove" data-key="{{ item.key }}" aria-label="{{ 'cart.general.remove' | t }}">
            {%- render 'icon', name: 'trash' -%}
          </button>
        </div>
      </li>
    {%- endfor -%}
  </ul>
  <div class="cart-drawer-foot">
    <div class="cart-drawer-subtotal">
      <span>{{ 'cart.general.subtotal' | t }}</span>
      <span class="cart-drawer-subtotal-amount">{{ cart.total_price | money }}</span>
    </div>
    <form action="{{ routes.cart_url }}" method="post">
      <button type="submit" name="checkout" class="btn btn-primary btn-block">{{ 'cart.general.checkout' | t }}</button>
    </form>
    <a href="{{ routes.cart_url }}" class="cart-drawer-viewcart">{{ 'cart.general.view_cart' | t }}</a>
  </div>
{%- else -%}
  <div class="cart-drawer-empty">
    {%- render 'icon', name: 'cart' -%}
    <p>{{ 'cart.general.empty' | t }}</p>
    <a href="{{ routes.all_products_collection_url }}" class="btn btn-outline" data-cart-drawer-close>{{ 'general.shop' | t }}</a>
  </div>
{%- endif -%}
