{%- comment -%}
  Product card. Usage: {% render 'product-card', product: product %}
{%- endcomment -%}
<div class="product-card shine-effect{% if settings.enable_card_tilt %} js-tilt{% endif %}" {% if settings.enable_scroll_reveal %}data-reveal{% endif %}>
  <a href="{{ product.url }}" class="product-card-image" aria-label="{{ product.title | escape }}">
    {%- if product.featured_media -%}
      <img src="{{ product.featured_media | image_url: width: 500 }}"
           srcset="{{ product.featured_media | image_url: width: 300 }} 300w,
                   {{ product.featured_media | image_url: width: 500 }} 500w,
                   {{ product.featured_media | image_url: width: 700 }} 700w"
           sizes="(max-width: 600px) 45vw, 260px"
           alt="{{ product.featured_media.alt | default: product.title | escape }}"
           width="500" height="{{ 500 | divided_by: product.featured_media.aspect_ratio | round }}"
           loading="lazy" decoding="async" data-decode>
      {%- if product.media[1] != blank -%}
        <img class="product-card-image-alt" src="{{ product.media[1] | image_url: width: 500 }}" alt="" width="500" height="500" loading="lazy" decoding="async" fetchpriority="low" data-decode>
      {%- endif -%}
    {%- else -%}
      <span class="product-card-placeholder">{%- render 'icon', name: 'cube' -%}</span>
    {%- endif -%}
    {%- assign card_models = product.media | where: 'media_type', 'model' | size -%}
    {%- if card_models > 0 -%}
      <span class="product-card-badge product-card-badge-3d">{%- render 'icon', name: 'cube' -%} 3D</span>
    {%- endif -%}
    {%- unless product.available -%}
      <span class="product-card-badge product-card-badge-sold">{{ 'products.product.sold_out' | t }}</span>
    {%- else -%}
      {%- comment -%} Etiquetas automáticas: oferta > pocas unidades > novedad (solo una, la más persuasiva) {%- endcomment -%}
      {%- assign pv = product.selected_or_first_available_variant -%}
      {%- if pv.compare_at_price > pv.price -%}
        {%- assign off_pct = pv.compare_at_price | minus: pv.price | times: 100 | divided_by: pv.compare_at_price -%}
        <span class="product-card-badge pcb-sale">-{{ off_pct }}%</span>
      {%- elsif settings.badge_low_stock > 0 and pv.inventory_management != blank and pv.inventory_quantity > 0 and pv.inventory_quantity <= settings.badge_low_stock -%}
        <span class="product-card-badge pcb-low">{{ 'products.product.few_left' | t }}</span>
      {%- else -%}
        {%- assign new_days = settings.badge_new_days | default: 0 -%}
        {%- if new_days > 0 -%}
          {%- assign age_s = 'now' | date: '%s' | minus: product.published_at | date: '%s' -%}
          {%- assign age_days = age_s | divided_by: 86400 -%}
          {%- if age_days <= new_days -%}
            <span class="product-card-badge pcb-new">{{ 'products.product.new' | t }}</span>
          {%- endif -%}
        {%- endif -%}
      {%- endif -%}
    {%- endunless -%}
    <div class="product-card-overlay"></div>
  </a>
  <div class="product-card-body">
    <h3 class="product-card-title"><a href="{{ product.url }}">{{ product.title }}</a></h3>
    <div class="product-card-footer">
      <div class="product-price">
        {%- if product.compare_at_price > product.price -%}
          <span class="product-price-compare">{{ product.compare_at_price | money }}</span>
        {%- endif -%}
        <span class="product-price-amount">{{ product.price | money }}</span>
      </div>
      {%- if product.available -%}
        <product-form>
          <form action="{{ routes.cart_add_url }}" method="post" enctype="multipart/form-data" data-quick-add>
            <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
            <button type="submit" class="add-to-cart-btn" aria-label="{{ 'products.product.add_to_cart' | t }}">
              {%- render 'icon', name: 'cart' -%}
            </button>
          </form>
        </product-form>
      {%- endif -%}
    </div>
  </div>
  <div class="product-card-glow"></div>
</div>
