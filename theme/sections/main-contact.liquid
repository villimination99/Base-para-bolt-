<section class="section-padding contact-page">
  <div class="container container--narrow">
    <h1 class="section-title">{{ page.title }}</h1>
    {%- if page.content != blank -%}<div class="rte page-content">{{ page.content }}</div>{%- endif -%}

    {%- form 'contact', class: 'customer-form contact-form' -%}
      {%- if form.posted_successfully? -%}
        <p class="form-success">{{ 'contact.form.post_success' | t | default: '¡Gracias! Te responderemos pronto.' }}</p>
      {%- endif -%}
      {{ form.errors | default_errors }}
      <label for="ContactName">{{ 'contact.form.name' | t | default: 'Nombre' }}</label>
      <input type="text" id="ContactName" name="contact[name]" autocomplete="name">
      <label for="ContactEmail">{{ 'contact.form.email' | t | default: 'Correo' }}</label>
      <input type="email" id="ContactEmail" name="contact[email]" autocomplete="email" required>
      <label for="ContactBody">{{ 'contact.form.message' | t | default: 'Mensaje' }}</label>
      <textarea id="ContactBody" name="contact[body]" rows="5" required></textarea>
      <button type="submit" class="btn btn-primary btn-lg btn-block">{{ 'contact.form.send' | t | default: 'Enviar' }}</button>
    {%- endform -%}
  </div>
</section>

{% schema %}
{ "name": "Contacto", "settings": [] }
{% endschema %}
