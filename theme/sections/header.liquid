{%- liquid
  assign yt = settings.social_youtube
  assign ig = settings.social_instagram
  assign trigger = section.settings.collections_trigger | downcase | strip
  assign dd_alpha = section.settings.menu_opacity | default: 85 | divided_by: 100.0
-%}
{%- style -%}
  #navbar, #mobile-menu { --dd-alpha: {{ dd_alpha }}; }
{%- endstyle -%}
<nav class="navbar{% if section.settings.transparent_top %} transparent-top{% endif %}" id="navbar" role="navigation" aria-label="{{ 'accessibility.main_nav' | t }}">
  <div class="navbar-inner">
    <a href="{{ routes.root_url }}" class="nav-logo" aria-label="{{ shop.name }}">
      {%- if settings.logo != blank -%}
        {%- assign logo_h = settings.logo_height | default: 44 -%}
        <img src="{{ settings.logo | image_url: width: 240 }}"
             alt="{{ shop.name | escape }}"
             width="{{ settings.logo.width }}" height="{{ settings.logo.height }}"
             style="height:{{ logo_h }}px;width:auto;object-fit:contain;">
      {%- else -%}
        {%- render 'logo-mark' -%}
        {%- assign brand_name = settings.brand_display_name | default: shop.name -%}
        <span class="nav-brand">
          <span class="nav-brand-grad">{{ brand_name | upcase }}</span>{%- if settings.brand_display_suffix != blank -%}<span class="nav-brand-99">{{ settings.brand_display_suffix }}</span>{%- endif -%}
        </span>
      {%- endif -%}
    </a>

    <div class="nav-links" id="nav-links">
      {%- for link in section.settings.menu.links -%}
        {%- assign link_key = link.title | downcase | strip -%}
        {%- assign is_coll_menu = false -%}
        {%- if trigger != blank and link_key == trigger -%}{%- assign is_coll_menu = true -%}{%- endif -%}

        {%- if is_coll_menu -%}
          <div class="nav-item nav-item--mega">
            <a href="{{ link.url }}" class="nav-link{% if link.active or link.child_active %} active{% endif %}">{{ link.title }}<span class="nav-caret">{%- render 'icon', name: 'chevron-down' -%}</span></a>
            <div class="nav-dropdown nav-mega">
              <div class="nav-mega-grid">
                {%- for collection in collections limit: section.settings.collections_count -%}
                  <a href="{{ collection.url }}" class="nav-mega-card">
                    <span class="nav-mega-media">
                      {%- if collection.featured_image -%}
                        <img src="{{ collection.featured_image | image_url: width: 160 }}" alt="{{ collection.title | escape }}" width="56" height="56" loading="lazy">
                      {%- else -%}{%- render 'icon', name: 'cube' -%}{%- endif -%}
                    </span>
                    <span class="nav-mega-title">{{ collection.title }}</span>
                  </a>
                {%- else -%}
                  <a href="{{ routes.all_products_collection_url }}" class="nav-mega-card"><span class="nav-mega-title">{{ 'general.shop' | t }}</span></a>
                {%- endfor -%}
              </div>
              <a href="{{ routes.all_products_collection_url }}" class="nav-mega-all">{{ 'general.view_all' | t }}{%- render 'icon', name: 'arrow-right' -%}</a>
            </div>
          </div>
        {%- elsif link.links.size > 0 -%}
          <div class="nav-item">
            <a href="{{ link.url }}" class="nav-link{% if link.active or link.child_active %} active{% endif %}">{{ link.title }}<span class="nav-caret">{%- render 'icon', name: 'chevron-down' -%}</span></a>
            <div class="nav-dropdown">
              {%- for child in link.links -%}
                <a href="{{ child.url }}"{% if child.url contains '://' %} target="_blank" rel="noopener"{% endif %}>{{ child.title }}</a>
              {%- endfor -%}
            </div>
          </div>
        {%- else -%}
          <a href="{{ link.url }}" class="nav-link{% if link.active %} active{% endif %}"{% if link.url contains '://' %} target="_blank" rel="noopener"{% endif %}>{{ link.title }}</a>
        {%- endif -%}
      {%- else -%}
        <a href="{{ routes.root_url }}" class="nav-link{% if template.name == 'index' %} active{% endif %}">{{ 'general.home' | t }}</a>
        <a href="{{ routes.all_products_collection_url }}" class="nav-link{% if template.name == 'collection' or template.name == 'product' %} active{% endif %}">{{ 'general.shop' | t }}</a>
      {%- endfor -%}
    </div>

    <div class="nav-actions">
      <a href="{{ routes.search_url }}" class="nav-icon-btn" title="{{ 'general.search.title' | t }}" aria-label="{{ 'general.search.title' | t }}">
        {%- render 'icon', name: 'search' -%}
      </a>

      <div class="nav-social">
        {%- if yt != blank -%}<a href="{{ yt }}" target="_blank" rel="noopener" class="youtube" aria-label="YouTube">{%- render 'icon', name: 'youtube' -%}</a>{%- endif -%}
        {%- if ig != blank -%}<a href="{{ ig }}" target="_blank" rel="noopener" class="instagram" aria-label="Instagram">{%- render 'icon', name: 'instagram' -%}</a>{%- endif -%}
      </div>

      <a href="{{ routes.cart_url }}" class="cart-btn" id="cart-btn-open" aria-label="{{ 'general.cart.title' | t }} ({{ cart.item_count }})"
         {% if settings.cart_type == 'drawer' %}data-cart-drawer-open{% endif %}>
        {%- render 'icon', name: 'cart' -%}
        <span class="cart-count" data-cart-count {% if cart.item_count == 0 %}hidden{% endif %}>{{ cart.item_count }}</span>
      </a>

      <button class="mobile-toggle" aria-label="{{ 'accessibility.menu' | t }}" aria-expanded="false" aria-controls="mobile-menu">
        {%- render 'icon', name: 'menu' -%}
      </button>
    </div>
  </div>
</nav>

<div class="mobile-menu" id="mobile-menu">
  <div class="mobile-menu-overlay" data-mobile-close></div>
  <div class="mobile-menu-panel" role="dialog" aria-modal="true" aria-label="{{ 'accessibility.menu' | t }}">
    <button class="mobile-menu-close" aria-label="{{ 'accessibility.close' | t }}" data-mobile-close>
      {%- render 'icon', name: 'close' -%}
    </button>
    {%- for link in section.settings.menu.links -%}
      {%- assign m_key = link.title | downcase | strip -%}
      <a href="{{ link.url }}"{% if link.url contains '://' %} target="_blank" rel="noopener"{% endif %}>{{ link.title }}</a>
      {%- if trigger != blank and m_key == trigger -%}
        <div class="mobile-submenu">
          {%- for collection in collections limit: section.settings.collections_count -%}<a href="{{ collection.url }}">{{ collection.title }}</a>{%- endfor -%}
        </div>
      {%- elsif link.links.size > 0 -%}
        <div class="mobile-submenu">
          {%- for child in link.links -%}<a href="{{ child.url }}"{% if child.url contains '://' %} target="_blank" rel="noopener"{% endif %}>{{ child.title }}</a>{%- endfor -%}
        </div>
      {%- endif -%}
    {%- else -%}
      <a href="{{ routes.root_url }}">{{ 'general.home' | t }}</a>
      <a href="{{ routes.all_products_collection_url }}">{{ 'general.shop' | t }}</a>
    {%- endfor -%}
    <div class="mobile-menu-social">
      {%- if yt != blank -%}<a href="{{ yt }}" target="_blank" rel="noopener" aria-label="YouTube">{%- render 'icon', name: 'youtube' -%}</a>{%- endif -%}
      {%- if ig != blank -%}<a href="{{ ig }}" target="_blank" rel="noopener" aria-label="Instagram">{%- render 'icon', name: 'instagram' -%}</a>{%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Encabezado",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menú de navegación",
      "default": "main-menu"
    },
    {
      "type": "checkbox",
      "id": "sticky",
      "label": "Encabezado fijo al hacer scroll",
      "default": true
    },
    { "type": "header", "content": "Estilo del menú" },
    {
      "type": "checkbox",
      "id": "transparent_top",
      "label": "Encabezado transparente arriba",
      "default": true,
      "info": "Transparente sobre el hero; se vuelve sólido al bajar."
    },
    {
      "type": "range",
      "id": "menu_opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Opacidad del fondo de los menús",
      "default": 70,
      "info": "0% = totalmente transparente (efecto cristal). 100% = sólido."
    },
    { "type": "header", "content": "Mega menú de colecciones" },
    {
      "type": "text",
      "id": "collections_trigger",
      "label": "Ítem que abre las colecciones",
      "default": "Colecciones",
      "info": "Escribe el nombre EXACTO del ítem del menú (ej: Colecciones o Catálogo). Al pasar el cursor mostrará tus colecciones automáticamente."
    },
    {
      "type": "range",
      "id": "collections_count",
      "min": 3,
      "max": 12,
      "step": 1,
      "label": "Colecciones a mostrar",
      "default": 6
    }
  ]
}
{% endschema %}
