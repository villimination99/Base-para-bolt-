{%- liquid
  # LA COPIA, RESUELTA UNA VEZ Y ANTES DE NADA.
  # Tiene que estar arriba del todo porque no solo se pinta: tambien
  # decide. Media seccion vive dentro de una condicion "si no esta
  # vacio", y si
  # esa guarda mirara el ajuste crudo -- que ahora va vacio a proposito,
  # para que mande el idioma -- escondería el texto que si existe.
  capture cx_eyebrow
    render 'copia', g: 'motivacion', b: 'cab', a: 'eyebrow', v: section.settings.eyebrow
  endcapture
  capture cx_heading
    render 'copia', g: 'motivacion', b: 'cab', a: 'heading', v: section.settings.heading
  endcapture
  capture cx_subheading
    render 'copia', g: 'motivacion', b: 'cab', a: 'subheading', v: section.settings.subheading
  endcapture
  capture cx_hint
    render 'copia', g: 'motivacion', b: 'cab', a: 'hint', v: section.settings.hint
  endcapture
-%}
{%- comment -%}
  Carrusel 3D curvo infinito (coverflow). Gira solo, se puede arrastrar y se pausa al pasar el ratón.
  100% editable: cada tarjeta es un bloque con imagen, título y enlace.
{%- endcomment -%}
{%- liquid
  assign neon = section.settings.neon_color
  if neon == blank
    assign neon = 'var(--neon-cyan)'
  endif
  case section.settings.card_size
    when 'small'
      assign radius = 'clamp(150px,32vw,260px)'
      assign cardw = 'clamp(120px,22vw,190px)'
      assign cardh = 'clamp(160px,30vw,250px)'
    when 'large'
      assign radius = 'clamp(210px,44vw,400px)'
      assign cardw = 'clamp(170px,30vw,280px)'
      assign cardh = 'clamp(220px,40vw,360px)'
    else
      assign radius = 'clamp(180px,38vw,330px)'
      assign cardw = 'clamp(150px,26vw,230px)'
      assign cardh = 'clamp(200px,34vw,300px)'
  endcase
  assign n = section.blocks.size
-%}
<section class="curved-carousel section-padding"
  style="--cc-neon:{{ neon }};--cc-radius:{{ radius }};--cc-w:{{ cardw }};--cc-h:{{ cardh }};--cc-n:{{ n }}">
  <div class="container">
    {%- if cx_eyebrow != blank -%}
      <span class="fancy-eyebrow">{{ cx_eyebrow }}</span>
    {%- endif -%}
    {%- if cx_heading != blank -%}
      <h2 class="section-title neon-underline">{{ cx_heading }}</h2>
    {%- endif -%}
    {%- if cx_subheading != blank -%}
      <p class="section-subtitle">{{ cx_subheading }}</p>
    {%- endif -%}

    {%- if n > 0 -%}
      <div class="cc-stage" data-cc data-cc-auto="{{ section.settings.autorotate }}" data-cc-speed="{{ section.settings.speed | times: 0.02 }}">
        <div class="cc-ring" data-cc-ring>
          {%- for block in section.blocks -%}
            {%- comment -%} La copia se resuelve UNA vez por bloque: se usa en
              el texto, en el alt de la imagen y en el rotulo de abajo. {%- endcomment -%}
            {%- capture cc_t -%}{%- render 'copia', g: 'motivacion', b: block.id, a: 'title', v: block.settings.title -%}{%- endcapture -%}
            {%- capture cc_c -%}{%- render 'copia', g: 'motivacion', b: block.id, a: 'caption', v: block.settings.caption -%}{%- endcapture -%}
            {%- assign tag = 'div' -%}
            {%- if block.settings.link != blank -%}{%- assign tag = 'a' -%}{%- endif -%}
            {%- assign is_text = false -%}
            {%- if block.settings.image == blank -%}{%- assign is_text = true -%}{%- endif -%}
            <{{ tag }} class="cc-item{% if is_text %} cc-item--text{% endif %}"{% if block.settings.link != blank %} href="{{ block.settings.link }}"{% endif %}
              style="--cc-i:{{ forloop.index0 }}" {{ block.shopify_attributes }}>
              <div class="cc-item-media">
                {%- if is_text -%}
                  <span class="cc-quote-mark" aria-hidden="true">&ldquo;</span>
                  <span class="cc-quote">{{ cc_t }}</span>
                  {%- if cc_c != blank -%}<span class="cc-quote-by">{{ cc_c }}</span>{%- endif -%}
                {%- else -%}
                  <img src="{{ block.settings.image | image_url: width: 560 }}"
                       srcset="{{ block.settings.image | image_url: width: 320 }} 320w,
                               {{ block.settings.image | image_url: width: 560 }} 560w"
                       sizes="280px"
                       alt="{{ cc_t | escape }}"
                       width="560" height="{{ 560 | divided_by: block.settings.image.aspect_ratio | round }}"
                       loading="lazy" decoding="async">
                {%- endif -%}
              </div>
              {%- unless is_text -%}
                {%- if cc_t != blank or cc_c != blank -%}
                  <div class="cc-item-info">
                    {%- if cc_t != blank -%}<span class="cc-item-title">{{ cc_t }}</span>{%- endif -%}
                    {%- if cc_c != blank -%}<span class="cc-item-caption">{{ cc_c }}</span>{%- endif -%}
                  </div>
                {%- endif -%}
              {%- endunless -%}
            </{{ tag }}>
          {%- endfor -%}
        </div>
      </div>
      {%- if cx_hint != blank -%}
        <p class="cc-hint">{%- render 'icon', name: 'chevron-left' -%} {{ cx_hint }} {%- render 'icon', name: 'chevron-right' -%}</p>
      {%- endif -%}
    {%- else -%}
      {%- if request.design_mode -%}<p class="cc-hint">Añade tarjetas desde el editor.</p>{%- endif -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Carrusel 3D curvo",
  "tag": "section",
  "class": "section-curved-carousel",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Etiqueta superior", "default": "EXPLORA" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Colección destacada" },
    { "type": "text", "id": "subheading", "label": "Subtítulo", "default": "Arrastra para girar el anillo" },
    { "type": "color", "id": "neon_color", "label": "Color neón de la sección" },
    {
      "type": "select",
      "id": "card_size",
      "label": "Tamaño de las tarjetas",
      "options": [
        { "value": "small", "label": "Pequeño" },
        { "value": "medium", "label": "Mediano" },
        { "value": "large", "label": "Grande" }
      ],
      "default": "medium"
    },
    { "type": "checkbox", "id": "autorotate", "label": "Girar automáticamente", "default": true },
    {
      "type": "range",
      "id": "speed",
      "min": 1,
      "max": 10,
      "step": 1,
      "label": "Velocidad de giro",
      "default": 3
    },
    { "type": "text", "id": "hint", "label": "Texto de ayuda", "default": "Arrastra o desliza" }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Tarjeta",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Imagen", "info": "Si la dejas vacía, la tarjeta se muestra como frase motivadora (solo texto)." },
        { "type": "text", "id": "title", "label": "Título / Frase" },
        { "type": "text", "id": "caption", "label": "Descripción / Autor" },
        { "type": "url", "id": "link", "label": "Enlace" }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Carrusel 3D curvo",
      "blocks": [
        { "type": "slide", "settings": { "title": "Ropa" } },
        { "type": "slide", "settings": { "title": "Equipo" } },
        { "type": "slide", "settings": { "title": "Suplementos" } },
        { "type": "slide", "settings": { "title": "Conocimiento" } },
        { "type": "slide", "settings": { "title": "Comunidad" } },
        { "type": "slide", "settings": { "title": "Elite" } }
      ]
    }
  ]
}
{% endschema %}
