{%- comment -%}
  Secuencia de marca: una animacion que se reproduce sola, en bucle, con el
  lenguaje visual de la tienda (haces de luz y marco de neon pulsante, los
  mismos del hero). Cada bloque es una escena y el tiempo se reparte entre
  las que haya.

  Es la alternativa en vivo a un archivo de video, y para una tienda es mejor:
  el texto es texto de verdad (Google lo indexa y un lector de pantalla lo
  lee), pesa unos 9 KB en vez de varios megabytes, se ve nitida en cualquier
  pantalla y reacciona al dedo o al raton.
{%- endcomment -%}

{%- liquid
  assign alto = section.settings.alto
  assign alto_movil = alto | times: 78 | divided_by: 100
  assign n = section.blocks | size
-%}

<section class="secuencia-sec{% if section.settings.compacta %} is-compacta{% endif %}"
         style="--sec-acento:{{ section.settings.acento }};--sec-fondo:{{ section.settings.fondo }};--sec-alto:{{ alto }}px;--sec-alto-movil:{{ alto_movil }}px;">
  <div class="container">
    <div class="secuencia"
         data-secuencia
         data-sec-duracion="{{ section.settings.duracion }}"
         data-sec-fondo="{{ section.settings.fondo }}"
         {% if settings.enable_scroll_reveal %}data-reveal{% endif %}>

      <canvas class="secuencia-lienzo" data-sec-lienzo aria-hidden="true"></canvas>

      {%- comment -%}
        Las escenas son texto real, no fotogramas. Van todas en el documento
        y se muestran por turnos; asi el buscador y el lector de pantalla ven
        el mensaje completo aunque nadie espere los catorce segundos.
      {%- endcomment -%}
      <div class="secuencia-escenas">
        {%- for block in section.blocks -%}
          {%- comment -%}
            data-sec-tipo: el motor reparte el tiempo POR TIPO de escena, no a
            partes iguales. La marca es una palabra y los pilares son nueve
            lineas de texto; darles los mismos segundos era la razon de que
            unas se leyeran con prisa y otras se quedaran esperando.
          {%- endcomment -%}
          <div class="secuencia-escena secuencia-escena--{{ block.type }}"
               data-sec-escena data-sec-tipo="{{ block.type }}" {{ block.shopify_attributes }}>
            {%- case block.type -%}

              {%- when 'marca' -%}
                <p class="secuencia-marca">{{ block.settings.texto }}</p>

              {%- when 'lema' -%}
                {%- comment -%}
                  Las dos lineas van en cajas propias porque entran por
                  separado: la primera cae, la segunda aterriza un tiempo
                  despues con la onda. Con las dos en el mismo nodo -- como
                  estaba, separadas por un <br> -- no habia forma de darles
                  tiempos distintos.
                {%- endcomment -%}
                <p class="secuencia-lema">
                  <span class="secuencia-lema-l1">
                    {%- render 'copia', g: 'secuencia', b: block.id, a: 'linea1', v: block.settings.linea1 -%}
                  </span>
                  {%- capture cb_l2 -%}{%- render 'copia', g: 'secuencia', b: block.id, a: 'linea2', v: block.settings.linea2 -%}{%- endcapture -%}
                  {%- if cb_l2 != blank -%}
                    <em class="secuencia-lema-l2">{{ cb_l2 }}</em>
                  {%- endif -%}
                </p>

              {%- when 'pilares' -%}
                <ul class="secuencia-pilares" role="list">
                  {%- for i in (1..3) -%}
                    {%- liquid
                      case i
                        when 1
                          assign ico = block.settings.icono1
                          assign tit = block.settings.titulo1
                          assign sub = block.settings.sub1
                          assign titulo_clave = 'titulo1'
                          assign sub_clave = 'sub1'
                        when 2
                          assign ico = block.settings.icono2
                          assign tit = block.settings.titulo2
                          assign sub = block.settings.sub2
                          assign titulo_clave = 'titulo2'
                          assign sub_clave = 'sub2'
                        else
                          assign ico = block.settings.icono3
                          assign tit = block.settings.titulo3
                          assign sub = block.settings.sub3
                          assign titulo_clave = 'titulo3'
                          assign sub_clave = 'sub3'
                      endcase
                      # La copia traducida ANTES de la guarda: si el campo
                      # esta vacio manda el idioma, y el pilar tiene que
                      # pintarse igual.
                      capture tit_i
                        render 'copia', g: 'secuencia', b: block.id, a: titulo_clave, v: tit
                      endcapture
                      capture sub_i
                        render 'copia', g: 'secuencia', b: block.id, a: sub_clave, v: sub
                      endcapture
                    -%}
                    {%- if tit_i != blank -%}
                      {%- comment -%}
                        --i es el turno del pilar. Los tres no entran a la vez:
                        se apilan en orden, como se cargan los discos en una
                        barra. La hoja de estilos lo usa para retrasar cada uno.
                      {%- endcomment -%}
                      <li class="secuencia-pilar" style="--i:{{ forloop.index0 }}">
                        <span class="secuencia-pilar-ico" aria-hidden="true">{%- render 'icon', name: ico -%}</span>
                        <span class="secuencia-pilar-txt">
                          <strong>{{ tit_i }}</strong>
                          {%- if sub_i != blank -%}<span>{{ sub_i }}</span>{%- endif -%}
                        </span>
                      </li>
                    {%- endif -%}
                  {%- endfor -%}
                </ul>

              {%- when 'cifra' -%}
                {%- comment -%}
                  EL NÚMERO SE CUENTA SOLO. Estaba escrito a mano —decía 37— y
                  en el catálogo había 41: ese tipo de cifra se queda vieja el
                  día que subes un producto y nadie vuelve a mirarla. Ahora sale
                  del propio catálogo. El campo del editor sigue existiendo por
                  si algún día quieres poner otra cosa ahí; si lo dejas vacío,
                  manda el recuento de verdad.
                {%- endcomment -%}
                {%- assign cifra_viva = collections.all.all_products_count -%}
                {%- if block.settings.numero != blank -%}
                  {%- assign cifra_viva = block.settings.numero -%}
                {%- endif -%}
                <p class="secuencia-cifra">{{ cifra_viva }}</p>
                {%- capture cb_pie -%}{%- render 'copia', g: 'secuencia', b: block.id, a: 'pie', v: block.settings.pie -%}{%- endcapture -%}
                {%- if cb_pie != blank -%}
                  <p class="secuencia-cifra-pie">{{ cb_pie }}</p>
                {%- endif -%}

              {%- when 'cierre' -%}
                {%- if block.settings.titulo != blank -%}
                  <p class="secuencia-cierre-tit">{{ block.settings.titulo }}</p>
                {%- endif -%}
                {%- capture cb_boton -%}{%- render 'copia', g: 'secuencia', b: block.id, a: 'boton', v: block.settings.boton -%}{%- endcapture -%}
                {%- comment -%}
                  btn-neon, no btn-primary. Este es el unico boton de la
                  seccion y compite con una animacion de dieciocho segundos:
                  el azul plano de .btn-primary desaparecia dentro de ella.
                  btn-neon es el mismo tratamiento que el boton de entrar de
                  la intro -- degradado de los tres colores de la marca con
                  tinta oscura encima -- para que la tienda entera tenga UN
                  solo boton principal y no tres dialectos.
                {%- endcomment -%}
                {%- if cb_boton != blank and block.settings.enlace != blank -%}
                  <a class="btn-neon secuencia-cta" href="{{ block.settings.enlace }}">
                    <span>{{ cb_boton }}</span>
                    {%- render 'icon', name: 'arrow-right' -%}
                  </a>
                {%- endif -%}

            {%- endcase -%}
          </div>
        {%- endfor -%}
      </div>

      {%- if n > 0 -%}
        <span class="secuencia-pista" aria-hidden="true">{{ 'general.sequence_hint' | t }}</span>
      {%- endif -%}
    </div>
  </div>
</section>

{%- comment -%}
  El script llega cuando la seccion se acerca, no durante la carga inicial:
  en la portada esta por debajo del pliegue y un <script defer> se descargaba
  igual aunque el visitante no bajara nunca.
{%- endcomment -%}
{%- render 'cargar-al-ver', archivo: 'secuencia.js', ancla: '[data-secuencia]' -%}

{% schema %}
{
  "name": "Secuencia de marca",
  "tag": "section",
  "class": "shopify-section--secuencia",
  "max_blocks": 6,
  "settings": [
    { "type": "color", "id": "acento", "label": "Color de acento", "default": "#00f0ff" },
    { "type": "color", "id": "fondo", "label": "Color de fondo", "default": "#05060a" },
    { "type": "range", "id": "alto", "min": 420, "max": 860, "step": 20, "unit": "px", "label": "Alto", "default": 640 },
    { "type": "range", "id": "duracion", "min": 10, "max": 32, "step": 2, "unit": "s", "label": "Duración del ciclo", "default": 18, "info": "El tiempo se reparte entre las escenas que tengas." },
    { "type": "checkbox", "id": "compacta", "label": "Menos espacio arriba y abajo", "default": false }
  ],
  "blocks": [
    { "type": "marca", "name": "Nombre de marca", "limit": 1,
      "settings": [ { "type": "text", "id": "texto", "label": "Texto", "default": "VILLUMINATION" } ] },
    { "type": "lema", "name": "Lema", "limit": 2,
      "settings": [
        { "type": "text", "id": "linea1", "label": "Primera línea", "default": "NO TE" },
        { "type": "text", "id": "linea2", "label": "Segunda línea (en color)", "default": "CONFORMES" } ] },
    { "type": "pilares", "name": "Tres pilares", "limit": 1,
      "settings": [
        { "type": "select", "id": "icono1", "label": "Icono 1", "default": "dumbbell", "options": [
          { "value": "dumbbell", "label": "Mancuerna" }, { "value": "supplement", "label": "Suplemento" },
          { "value": "shirt", "label": "Camiseta" }, { "value": "trophy", "label": "Trofeo" },
          { "value": "brain", "label": "Mente" }, { "value": "book", "label": "Libro" },
          { "value": "bolt", "label": "Rayo" }, { "value": "body3d", "label": "Cuerpo" } ] },
        { "type": "text", "id": "titulo1", "label": "Título 1", "default": "FUERZA" },
        { "type": "text", "id": "sub1", "label": "Subtítulo 1", "default": "EQUIPO Y ACCESORIOS" },
        { "type": "select", "id": "icono2", "label": "Icono 2", "default": "supplement", "options": [
          { "value": "dumbbell", "label": "Mancuerna" }, { "value": "supplement", "label": "Suplemento" },
          { "value": "shirt", "label": "Camiseta" }, { "value": "trophy", "label": "Trofeo" },
          { "value": "brain", "label": "Mente" }, { "value": "book", "label": "Libro" },
          { "value": "bolt", "label": "Rayo" }, { "value": "body3d", "label": "Cuerpo" } ] },
        { "type": "text", "id": "titulo2", "label": "Título 2", "default": "NUTRICIÓN" },
        { "type": "text", "id": "sub2", "label": "Subtítulo 2", "default": "SUPLEMENTOS" },
        { "type": "select", "id": "icono3", "label": "Icono 3", "default": "book", "options": [
          { "value": "dumbbell", "label": "Mancuerna" }, { "value": "supplement", "label": "Suplemento" },
          { "value": "shirt", "label": "Camiseta" }, { "value": "trophy", "label": "Trofeo" },
          { "value": "brain", "label": "Mente" }, { "value": "book", "label": "Libro" },
          { "value": "bolt", "label": "Rayo" }, { "value": "body3d", "label": "Cuerpo" } ] },
        { "type": "text", "id": "titulo3", "label": "Título 3", "default": "CONSTANCIA" },
        { "type": "text", "id": "sub3", "label": "Subtítulo 3", "default": "PLANES Y CÓDICES" } ] },
    { "type": "cifra", "name": "Cifra", "limit": 1,
      "settings": [
        { "type": "text", "id": "numero", "label": "Número (vacío = se cuenta solo)",
          "info": "Déjalo vacío y pone el número real de productos del catálogo, que se actualiza solo. Escribe algo aquí únicamente si quieres destacar otra cifra." },
        { "type": "text", "id": "pie", "label": "Texto debajo", "default": "PRODUCTOS · UNA SOLA META" } ] },
    { "type": "cierre", "name": "Cierre", "limit": 1,
      "settings": [
        { "type": "text", "id": "titulo", "label": "Título", "default": "VILLUMINATIONS.COM" },
        { "type": "text", "id": "boton", "label": "Texto del botón", "default": "VER CATÁLOGO" },
        { "type": "url", "id": "enlace", "label": "Enlace del botón" } ] }
  ],
  "presets": [
    { "name": "Secuencia de marca",
      "blocks": [ { "type": "lema" }, { "type": "pilares" }, { "type": "cifra" }, { "type": "marca" }, { "type": "cierre" } ] }
  ]
}
{% endschema %}
