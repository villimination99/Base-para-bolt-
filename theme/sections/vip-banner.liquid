  "settings": [
    { "type": "text", "id": "badge", "label": "Insignia", "default": "VI.P · GRATIS, SIN REGISTRO" },
    { "type": "text", "id": "title", "label": "Título", "default": "TOCA UN MÚSCULO Y VE QUÉ ENTRENAR" },
