<section class="section-padding">
  <div class="container">
    <div class="vip-banner" {% if settings.enable_scroll_reveal %}data-reveal{% endif %}>
      <div class="vip-banner-border" aria-hidden="true"></div>
      <div class="vip-banner-inner">
        <div class="vip-banner-glow vip-banner-glow-1" aria-hidden="true"></div>
        <div class="vip-banner-glow vip-banner-glow-2" aria-hidden="true"></div>
        {%- if section.settings.image != blank -%}
          <img class="vip-banner-img" src="{{ section.settings.image | image_url: width: 1600 }}" alt="" width="1600" height="{{ 1600 | divided_by: section.settings.image.aspect_ratio | round }}" loading="lazy">
          <div class="vip-banner-shade" aria-hidden="true"></div>
        {%- endif -%}
        <div class="vip-banner-content">
          {%- if section.settings.badge != blank -%}
            <span class="vip-badge">{%- render 'icon', name: 'bolt' -%}{{ section.settings.badge }}</span>
          {%- endif -%}
          <h2 class="vip-title">{{ section.settings.title }}</h2>
          {%- if section.settings.text != blank -%}<p class="vip-text">{{ section.settings.text }}</p>{%- endif -%}
          <div class="vip-perks">
            {%- for block in section.blocks -%}
              <span class="vip-perk" {{ block.shopify_attributes }}>{%- render 'icon', name: 'check' -%}{{ block.settings.text }}</span>
            {%- endfor -%}
          </div>
          <a href="{{ section.settings.button_url | default: '/pages/vi-p' }}" class="btn btn-vip btn-lg">
            {{ section.settings.button_label }}{%- render 'icon', name: 'arrow-right' -%}
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Banner VIP",
  "settings": [
    { "type": "text", "id": "badge", "label": "Insignia", "default": "ACCESO EXCLUSIVO" },
    { "type": "text", "id": "title", "label": "Título", "default": "HAZTE VI.P" },
    { "type": "textarea", "id": "text", "label": "Texto", "default": "Únete al círculo interno: descuentos secretos, drops anticipados y contenido que nadie más ve." },
    { "type": "text", "id": "button_label", "label": "Texto del botón", "default": "QUIERO SER VI.P" },
    { "type": "url", "id": "button_url", "label": "Enlace del botón", "info": "Por defecto: /pages/vi-p" },
    { "type": "image_picker", "id": "image", "label": "Imagen de fondo (opcional)" }
  ],
  "blocks": [
    {
      "type": "perk",
      "name": "Beneficio",
      "settings": [ { "type": "text", "id": "text", "label": "Texto", "default": "Descuentos exclusivos" } ]
    }
  ],
  "presets": [
    { "name": "Banner VIP", "blocks": [
      { "type": "perk", "settings": { "text": "Descuentos secretos" } },
      { "type": "perk", "settings": { "text": "Drops anticipados" } },
      { "type": "perk", "settings": { "text": "Contenido exclusivo" } }
    ] }
  ]
}
{% endschema %}
