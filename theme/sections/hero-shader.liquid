{%- comment -%}
  Hero con fondo de shader "borde pulsante" que reacciona al desplazamiento.

  El shader es una adaptacion de Paper Shaders (Pulsing Border),
  https://shaders.paper.design/pulsing-border — licencia Apache-2.0.
  Portado a WebGL en JavaScript plano: este tema es Liquid, no React.

  El JS solo se carga en las paginas que llevan esta seccion, y en tiempo libre
  para no competir con el primer pintado. Si no hay WebGL, si el visitante pide
  movimiento reducido o si tiene el ahorro de datos activado, queda el degradado
  CSS de debajo: nunca se ve un hueco negro.
{%- endcomment -%}
{%- liquid
  assign c_bg = section.settings.color_bg | default: settings.color_bg
  assign c1 = section.settings.color_1 | default: settings.color_purple
  assign c2 = section.settings.color_2 | default: settings.color_cyan
  assign c3 = section.settings.color_3 | default: settings.color_pink
  assign h_min = section.settings.height | default: 82
-%}
<section class="hero hero-shader" style="--hs-min:{{ h_min }}svh;--hs-bg:{{ c_bg }};--hs-c2:{{ c2 }};">
  <div class="hero-shader-bg" aria-hidden="true">
    <canvas data-hero-shader
            class="hero-shader-canvas"
            data-bg="{{ c_bg }}"
            data-c1="{{ c1 }}"
            data-c2="{{ c2 }}"
            data-c3="{{ c3 }}"
            data-scale="{{ section.settings.scale | divided_by: 100.0 }}"
            data-intensity="{{ section.settings.intensity | divided_by: 100.0 }}"
            data-thickness="{{ section.settings.thickness | divided_by: 100.0 }}"
            data-grain="{{ section.settings.grain | divided_by: 1000.0 }}"
            data-speed="{{ section.settings.speed | divided_by: 100.0 }}"
            data-scroll="{% if section.settings.react_scroll %}true{% else %}false{% endif %}"></canvas>
    {%- if section.settings.overlay > 0 -%}
      <span class="hero-shader-shade" style="opacity:{{ section.settings.overlay | divided_by: 100.0 }};"></span>
    {%- endif -%}
  </div>

  {%- comment -%}
    Dos capas a proposito: la de fuera lleva la revelacion al entrar en pantalla
    (data-reveal escribe transform y opacity) y la de dentro lleva el
    desplazamiento del scroll. Si compartieran elemento, .reveal-init.is-visible
    pondria transform:none y borraria el efecto de scroll.
  {%- endcomment -%}
  <div class="hero-content hero-shader-content" {% if settings.enable_scroll_reveal %}data-reveal{% endif %}>
    <div class="hero-shader-shift">
      {%- if section.settings.eyebrow != blank -%}
        <span class="section-eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      {%- if section.settings.title != blank -%}
        <h1 class="hero-title">{{ section.settings.title }}</h1>
      {%- endif -%}
      {%- if section.settings.subtitle != blank -%}
        <p class="hero-subtitle">{{ section.settings.subtitle }}</p>
      {%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <div class="hero-ctas">
          <a href="{{ section.settings.button_url | default: routes.all_products_collection_url }}" class="btn btn-primary btn-lg">
            {{ section.settings.button_label }}{%- render 'icon', name: 'arrow-right' -%}
          </a>
          {%- if section.settings.button2_label != blank -%}
            <a href="{{ section.settings.button2_url | default: routes.root_url }}" class="btn btn-outline btn-lg">{{ section.settings.button2_label }}</a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>

  {%- if section.settings.show_hint -%}
    <span class="hero-shader-hint" aria-hidden="true">
      {%- render 'icon', name: 'chevron-down' -%}
    </span>
  {%- endif -%}
</section>

<script>
  (function () {
    var src = "{{ 'hero-shader.js' | asset_url }}";
    if (document.querySelector('script[data-hs-src]')) return;
    function load() {
      var s = document.createElement('script');
      s.src = src; s.defer = true; s.setAttribute('data-hs-src', '1');
      document.body.appendChild(s);
    }
    if ('requestIdleCallback' in window) requestIdleCallback(load, { timeout: 1500 });
    else window.addEventListener('load', function () { setTimeout(load, 150); });
  })();
</script>

{% schema %}
{
  "name": "Hero shader",
  "tag": "section",
  "settings": [
    { "type": "paragraph", "content": "Fondo animado en WebGL que reacciona al desplazamiento. Si el visitante pide movimiento reducido o tiene el ahorro de datos activado, se muestra un degradado fijo en su lugar." },
    { "type": "text", "id": "eyebrow", "label": "Etiqueta", "default": "VILLUMINATION" },
    { "type": "text", "id": "title", "label": "Titulo", "default": "TRANSFORMA TU CUERPO" },
    { "type": "textarea", "id": "subtitle", "label": "Subtitulo", "default": "Domina tu mente. Equipo, ropa y suplementos para quienes no se conforman." },
    { "type": "text", "id": "button_label", "label": "Boton principal", "default": "VER CATALOGO" },
    { "type": "url", "id": "button_url", "label": "Enlace del boton principal" },
    { "type": "text", "id": "button2_label", "label": "Boton secundario" },
    { "type": "url", "id": "button2_url", "label": "Enlace del boton secundario" },
    { "type": "header", "content": "Movimiento" },
    { "type": "checkbox", "id": "react_scroll", "label": "Reaccionar al desplazamiento", "default": true, "info": "El marco se acerca, engrosa y acelera a medida que se baja." },
    { "type": "range", "id": "speed", "min": 20, "max": 150, "step": 5, "unit": "%", "label": "Velocidad del pulso", "default": 60 },
    { "type": "range", "id": "intensity", "min": 5, "max": 100, "step": 5, "unit": "%", "label": "Intensidad", "default": 35 },
    { "type": "checkbox", "id": "show_hint", "label": "Flecha de bajar", "default": true },
    { "type": "header", "content": "Forma" },
    { "type": "range", "id": "height", "min": 50, "max": 100, "step": 2, "unit": "%", "label": "Alto de la pantalla", "default": 82 },
    { "type": "range", "id": "scale", "min": 80, "max": 200, "step": 5, "unit": "%", "label": "Tamano del marco", "default": 125 },
    { "type": "range", "id": "thickness", "min": 5, "max": 100, "step": 5, "unit": "%", "label": "Grosor del borde", "default": 30 },
    { "type": "range", "id": "grain", "min": 0, "max": 120, "step": 5, "label": "Grano", "default": 40, "info": "Textura de pelicula. 0 lo desactiva." },
    { "type": "range", "id": "overlay", "min": 0, "max": 80, "step": 5, "unit": "%", "label": "Oscurecer el fondo", "default": 25, "info": "Sube esto si el texto no se lee bien." },
    { "type": "header", "content": "Colores" },
    { "type": "paragraph", "content": "Vacios = se usan los colores globales del tema." },
    { "type": "color", "id": "color_bg", "label": "Fondo" },
    { "type": "color", "id": "color_1", "label": "Color 1 (interior)" },
    { "type": "color", "id": "color_2", "label": "Color 2 (medio)" },
    { "type": "color", "id": "color_3", "label": "Color 3 (brillo)" }
  ],
  "presets": [{ "name": "Hero shader" }]
}
{% endschema %}
