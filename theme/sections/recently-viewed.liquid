{%- comment -%}
  Productos vistos recientemente. Se guardan en el navegador del visitante (localStorage),
  así que no requiere servidor ni apps. Si no hay historial, la sección no se muestra.
{%- endcomment -%}
<section class="section-padding recently-viewed" data-recently-viewed data-limit="{{ section.settings.limit }}" hidden>
  <div class="container">
    <div class="collection-index-head">
      {%- capture cx_eyebrow -%}{%- render 'copia', g: 'sec', b: 'recently-viewed', a: 'eyebrow', v: section.settings.eyebrow -%}{%- endcapture -%}
      {%- capture cx_heading -%}{%- render 'copia', g: 'sec', b: 'recently-viewed', a: 'heading', v: section.settings.heading -%}{%- endcapture -%}
      {%- if cx_eyebrow != blank -%}<span class="fancy-eyebrow">{{ cx_eyebrow }}</span>{%- endif -%}
      {%- if cx_heading != blank -%}<h2 class="section-title neon-underline">{{ cx_heading }}</h2>{%- endif -%}
    </div>
    <div class="product-grid rv-grid" data-rv-grid></div>
  </div>
</section>

{% schema %}
{
  "name": "Vistos recientemente",
  "tag": "section",
  "class": "section-recently-viewed",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Etiqueta" },
    { "type": "text", "id": "heading", "label": "Título" },
    { "type": "range", "id": "limit", "min": 2, "max": 8, "step": 1, "label": "Máximo de productos", "default": 4 }
  ],
  "presets": [{ "name": "Vistos recientemente" }]
}
{% endschema %}
