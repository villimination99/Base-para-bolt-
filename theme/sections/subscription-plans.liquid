{%- liquid
  # LA COPIA, RESUELTA UNA VEZ Y ANTES DE NADA.
  # Tiene que estar arriba del todo porque no solo se pinta: tambien
  # decide. Media seccion vive dentro de una condicion "si no esta
  # vacio", y si
  # esa guarda mirara el ajuste crudo -- que ahora va vacio a proposito,
  # para que mande el idioma -- escondería el texto que si existe.
  capture cx_eyebrow
    render 'copia', g: 'sec', b: 'subscription-plans', a: 'eyebrow', v: section.settings.eyebrow
  endcapture
  capture cx_title
    render 'copia', g: 'sec', b: 'subscription-plans', a: 'title', v: section.settings.title
  endcapture
  capture cx_subtitle
    render 'copia', g: 'sec', b: 'subscription-plans', a: 'subtitle', v: section.settings.subtitle
  endcapture
-%}
<section class="section-padding" id="plans">
  <div class="container">
    <div class="section-head" {% if settings.enable_scroll_reveal %}data-reveal{% endif %}>
      {%- if cx_eyebrow != blank -%}<span class="section-eyebrow neon-text-green">{{ cx_eyebrow }}</span>{%- endif -%}
      <h2 class="section-title">{{ cx_title }}</h2>
      {%- if cx_subtitle != blank -%}<p class="section-subtitle">{{ cx_subtitle }}</p>{%- endif -%}
    </div>

    <div class="plans-grid">
      {%- for block in section.blocks -%}
        {%- assign accent = block.settings.accent -%}
        <div class="plan-card{% if block.settings.featured %} plan-card--featured{% endif %}" style="--accent:{{ accent }};" {{ block.shopify_attributes }} {% if settings.enable_scroll_reveal %}data-reveal{% endif %}>
          {%- if block.settings.featured and block.settings.badge != blank -%}
            <span class="plan-badge">{{ block.settings.badge }}</span>
          {%- endif -%}
          <div class="plan-head">
            <h3 class="plan-name">{%- render 'copia', g: 'planes', b: block.id, a: 'name', v: block.settings.name -%}</h3>
            {%- capture cb_tag -%}{%- render 'copia', g: 'planes', b: block.id, a: 'tagline', v: block.settings.tagline -%}{%- endcapture -%}
          {%- if cb_tag != blank -%}<span class="plan-tagline">{{ cb_tag }}</span>{%- endif -%}
          </div>
          <div class="plan-price">
            <span class="plan-price-amount">{{ block.settings.price }}</span>
            {%- if block.settings.period != blank -%}<span class="plan-price-period">{{ block.settings.period }}</span>{%- endif -%}
          </div>
          {%- if block.settings.features != blank -%}
            {%- comment -%}
              El ajuste es de tipo richtext, así que ya trae su propio <ul> o
              sus <p>. Envolverlo en otro <ul> producía una lista dentro de una
              lista sin <li> intermedio: HTML inválido que los lectores de
              pantalla anuncian mal. El contenedor pasa a ser un <div>.
            {%- endcomment -%}
            <div class="plan-features rte">{{ block.settings.features }}</div>
          {%- endif -%}
          <a href="{{ block.settings.button_url | default: routes.all_products_collection_url }}" class="btn {% if block.settings.featured %}btn-primary{% else %}btn-outline{% endif %} btn-block">{%- render 'copia', g: 'sec', b: 'subscription-plans', a: 'button_label', v: block.settings.button_label -%}</a>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Planes de suscripción",
  "settings": [
    {
      "type": "paragraph",
      "content": "Los textos de esta seccion viven en los archivos de idioma del tema (locales/*.json, rama \"inicio\"), no aqui: asi se traducen solos en los cinco idiomas y viajan dentro del zip. Si escribes algo en un campo, lo tuyo manda -- pero en todos los idiomas a la vez. Para cambiar la copia traducida se edita marca/copia-portada.json y se corre node marca/generar-copia.mjs."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Etiqueta"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Título"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtítulo"
    }
  ],
  "blocks": [
    {
      "type": "plan",
      "name": "Plan",
      "settings": [
        {
          "type": "text",
          "id": "name",
          "label": "Nombre",
          "default": "Básico"
        },
        {
          "type": "text",
          "id": "tagline",
          "label": "Descripción corta",
          "default": "Volumen Limpio"
        },
        {
          "type": "text",
          "id": "price",
          "label": "Precio",
          "default": "$9.99"
        },
        {
          "type": "text",
          "id": "period",
          "label": "Periodo",
          "default": "/mes"
        },
        {
          "type": "richtext",
          "id": "features",
          "label": "Características (lista)",
          "default": "<ul><li>Plan de volumen</li><li>Macros optimizados</li><li>Lista de compras semanal</li></ul>"
        },
        {
          "type": "color",
          "id": "accent",
          "label": "Color de acento",
          "default": "#00e87b"
        },
        {
          "type": "checkbox",
          "id": "featured",
          "label": "Destacado",
          "default": false
        },
        {
          "type": "text",
          "id": "badge",
          "label": "Etiqueta de destacado",
          "default": "Más Popular"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Texto del botón",
          "default": "Suscribirme"
        },
        {
          "type": "url",
          "id": "button_url",
          "label": "Enlace del botón"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Planes de suscripción",
      "blocks": [
        {
          "type": "plan",
          "settings": {
            "name": "Básico",
            "price": "$9.99",
            "accent": "#00e87b"
          }
        },
        {
          "type": "plan",
          "settings": {
            "name": "Pro",
            "price": "$19.99",
            "accent": "#00d4ff",
            "featured": true
          }
        },
        {
          "type": "plan",
          "settings": {
            "name": "Elite",
            "price": "$39.99",
            "accent": "#ff7700"
          }
        }
      ]
    }
  ]
}
{% endschema %}
