<section class="section-padding">
  <div class="container">
    {%- if section.settings.title != blank -%}
      <div class="section-head" {% if settings.enable_scroll_reveal %}data-reveal{% endif %}>
        {%- if section.settings.eyebrow != blank -%}<span class="section-eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
        <h2 class="section-title">{{ section.settings.title }}</h2>
      </div>
    {%- endif -%}
    <div class="gallery-grid">
      {%- for block in section.blocks -%}
        {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}" class="gallery-item" {{ block.shopify_attributes }} {% if settings.enable_scroll_reveal %}data-reveal{% endif %}>{%- else -%}<div class="gallery-item" {{ block.shopify_attributes }} {% if settings.enable_scroll_reveal %}data-reveal{% endif %}>{%- endif -%}
          {%- if block.settings.image != blank -%}
            {%- comment -%}
              La casilla es cuadrada (aspect-ratio 1/1 + object-fit cover), pero
              se pedía la imagen completa y el recorte lo hacía el navegador:
              con una foto vertical se descargaban bytes de más para nada.
              Ahora recorta Shopify en el servidor, con srcset.
            {%- endcomment -%}
            <img src="{{ block.settings.image | image_url: width: 600, height: 600, crop: 'center' }}"
                 srcset="{{ block.settings.image | image_url: width: 300, height: 300, crop: 'center' }} 300w,
                         {{ block.settings.image | image_url: width: 450, height: 450, crop: 'center' }} 450w,
                         {{ block.settings.image | image_url: width: 600, height: 600, crop: 'center' }} 600w"
                 sizes="(min-width: 861px) 25vw, 45vw"
                 alt="{{ block.settings.image.alt | escape }}" width="400" height="400" loading="lazy">
          {%- else -%}
            <span class="product-card-placeholder">{%- render 'icon', name: 'cube' -%}</span>
          {%- endif -%}
        {%- if block.settings.link != blank -%}</a>{%- else -%}</div>{%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Galería",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Etiqueta" },
    { "type": "text", "id": "title", "label": "Título", "default": "GALERÍA" }
  ],
  "blocks": [
    { "type": "image", "name": "Imagen", "settings": [
      { "type": "image_picker", "id": "image", "label": "Imagen" },
      { "type": "url", "id": "link", "label": "Enlace (opcional)" } ] }
  ],
  "presets": [ { "name": "Galería", "blocks": [ { "type": "image" }, { "type": "image" }, { "type": "image" }, { "type": "image" } ] } ]
}
{% endschema %}
