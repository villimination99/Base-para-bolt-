<section class="section-padding">
  <div class="container">
    <div class="section-head" {% if settings.enable_scroll_reveal %}data-reveal{% endif %}>
      {%- if section.settings.eyebrow != blank -%}<span class="section-eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2 class="section-title">{{ section.settings.title }}</h2>
    </div>
    <div class="collection-list-grid">
      {%- for block in section.blocks -%}
        {%- assign coll = block.settings.collection -%}
        {%- if coll != blank -%}
          <a href="{{ coll.url }}" class="collection-tile{% if settings.enable_card_tilt %} js-tilt{% endif %}" {{ block.shopify_attributes }} {% if settings.enable_scroll_reveal %}data-reveal{% endif %}>
            <div class="collection-tile-media">
              {%- if block.settings.image != blank -%}
                <img src="{{ block.settings.image | image_url: width: 700, height: 500, crop: 'center' }}"
                             srcset="{{ block.settings.image | image_url: width: 300, height: 214, crop: 'center' }} 300w,
                             {{ block.settings.image | image_url: width: 450, height: 321, crop: 'center' }} 450w,
                             {{ block.settings.image | image_url: width: 700, height: 500, crop: 'center' }} 700w"
                             sizes="(min-width: 861px) 33vw, 100vw" alt="{{ coll.title | escape }}" width="700" height="500" loading="lazy">
              {%- elsif coll.featured_image -%}
                <img src="{{ coll.featured_image | image_url: width: 700, height: 500, crop: 'center' }}"
                             srcset="{{ coll.featured_image | image_url: width: 300, height: 214, crop: 'center' }} 300w,
                             {{ coll.featured_image | image_url: width: 450, height: 321, crop: 'center' }} 450w,
                             {{ coll.featured_image | image_url: width: 700, height: 500, crop: 'center' }} 700w"
                             sizes="(min-width: 861px) 33vw, 100vw" alt="{{ coll.title | escape }}" width="700" height="500" loading="lazy">
              {%- else -%}
                {%- comment -%}
                  Una colección sin foto mostraba un icono de cubo gris en un
                  hueco vacío, y en una rejilla junto a fotos de verdad eso se
                  lee como «esto está roto». La misma portada generada que usan
                  las entradas del blog: neón de la marca, la inicial y el
                  barrido. Coherente, y sin inventar una fotografía que no hay.
                {%- endcomment -%}
                <span class="article-card-media article-card-media--generada collection-tile-generada ntile-{{ forloop.index0 | modulo: 4 }}" aria-hidden="true">
                  <span class="article-card-glifo">{{ coll.title | strip_html | slice: 0 | upcase }}</span>
                </span>
              {%- endif -%}
              <div class="collection-tile-overlay"></div>
            </div>
            <h3 class="collection-tile-title">{{ block.settings.title | default: coll.title }}</h3>
          </a>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Lista de colecciones",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Etiqueta" },
    { "type": "text", "id": "title", "label": "Título", "default": "EXPLORA POR CATEGORÍA" }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Colección",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Colección" },
        { "type": "image_picker", "id": "image", "label": "Imagen personalizada (opcional)" },
        { "type": "text", "id": "title", "label": "Título personalizado (opcional)" }
      ]
    }
  ],
  "presets": [ { "name": "Lista de colecciones", "blocks": [ { "type": "collection" }, { "type": "collection" }, { "type": "collection" } ] } ]
}
{% endschema %}
