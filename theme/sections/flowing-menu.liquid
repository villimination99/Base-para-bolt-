{%- comment -%}
  Flowing Menu — filas de texto grande. Al pasar el cursor, una cinta neón con
  el nombre y una imagen aparece deslizándose desde el borde por donde entra el ratón.
  100% editable: cada fila es un bloque (texto, imagen, enlace).
{%- endcomment -%}
{%- liquid
  assign neon = section.settings.neon_color
  if neon == blank
    assign neon = 'var(--neon-cyan)'
  endif
-%}
<section class="flowing-menu section-padding" style="--fm-neon:{{ neon }}">
  <div class="container">
    {%- if section.settings.eyebrow != blank -%}
      <span class="fancy-eyebrow">{{ section.settings.eyebrow }}</span>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2 class="section-title neon-underline">{{ section.settings.heading }}</h2>
    {%- endif -%}
  </div>

  {%- if section.blocks.size > 0 -%}
    <nav class="fm-list">
      {%- for block in section.blocks -%}
        {%- assign tag = 'div' -%}
        {%- if block.settings.link != blank -%}{%- assign tag = 'a' -%}{%- endif -%}
        <{{ tag }} class="fm-row" data-fm-row{% if block.settings.link != blank %} href="{{ block.settings.link }}"{% endif %} {{ block.shopify_attributes }}>
          <span class="fm-row-text">{{ block.settings.label | escape }}</span>
          <div class="fm-marquee" aria-hidden="true">
            <div class="fm-marquee-inner">
              {%- for i in (1..8) -%}
                <span class="fm-marquee-text">{{ block.settings.label | escape }}</span>
                {%- if block.settings.image != blank -%}
                  <span class="fm-marquee-img" style="background-image:url({{ block.settings.image | image_url: width: 400 }})"></span>
                {%- else -%}
                  <span class="fm-marquee-img fm-marquee-img--empty">{%- render 'icon', name: 'bolt' -%}</span>
                {%- endif -%}
              {%- endfor -%}
            </div>
          </div>
        </{{ tag }}>
      {%- endfor -%}
    </nav>
  {%- else -%}
    <div class="container"><p class="cc-hint">Añade filas desde el editor.</p></div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Flowing Menu",
  "tag": "section",
  "class": "section-flowing-menu",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Etiqueta superior", "default": "CATEGORÍAS" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Explora el universo VILLUMINATION" },
    { "type": "color", "id": "neon_color", "label": "Color neón de la sección" }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Fila",
      "settings": [
        { "type": "text", "id": "label", "label": "Texto", "default": "Suplementos" },
        { "type": "image_picker", "id": "image", "label": "Imagen (aparece al pasar el cursor)" },
        { "type": "url", "id": "link", "label": "Enlace" }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Flowing Menu",
      "blocks": [
        { "type": "row", "settings": { "label": "Ropa" } },
        { "type": "row", "settings": { "label": "Equipo" } },
        { "type": "row", "settings": { "label": "Suplementos" } },
        { "type": "row", "settings": { "label": "Conocimiento" } }
      ]
    }
  ]
}
{% endschema %}
