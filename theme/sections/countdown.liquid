<section class="section-padding countdown-section" style="{% if section.settings.bg != blank %}background:{{ section.settings.bg }};{% endif %}">
  <div class="container container--narrow" style="text-align:center;" {% if settings.enable_scroll_reveal %}data-reveal{% endif %}>
    {%- if section.settings.eyebrow != blank -%}<span class="section-eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
    <h2 class="section-title">{{ section.settings.title }}</h2>
    {%- if section.settings.subtitle != blank -%}<p class="section-subtitle">{{ section.settings.subtitle }}</p>{%- endif -%}

    <div class="countdown" data-countdown="{{ section.settings.end_date }}" data-expired="{{ section.settings.expired_text | escape }}">
      <div class="countdown-unit"><span class="countdown-num" data-cd-days>00</span><span class="countdown-label">días</span></div>
      <div class="countdown-sep">:</div>
      <div class="countdown-unit"><span class="countdown-num" data-cd-hours>00</span><span class="countdown-label">horas</span></div>
      <div class="countdown-sep">:</div>
      <div class="countdown-unit"><span class="countdown-num" data-cd-mins>00</span><span class="countdown-label">min</span></div>
      <div class="countdown-sep">:</div>
      <div class="countdown-unit"><span class="countdown-num" data-cd-secs>00</span><span class="countdown-label">seg</span></div>
    </div>

    {%- if section.settings.button_label != blank -%}
      <div class="section-cta"><a href="{{ section.settings.button_url | default: routes.all_products_collection_url }}" class="btn btn-primary btn-lg">{{ section.settings.button_label }}</a></div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Cuenta regresiva",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Etiqueta", "default": "Oferta por tiempo limitado" },
    { "type": "text", "id": "title", "label": "Título", "default": "LA OFERTA TERMINA EN" },
    { "type": "textarea", "id": "subtitle", "label": "Subtítulo", "default": "No te quedes fuera." },
    { "type": "text", "id": "end_date", "label": "Fecha y hora final", "info": "Formato: 2026-12-31 23:59", "default": "2026-12-31 23:59" },
    { "type": "text", "id": "expired_text", "label": "Texto al terminar", "default": "¡La oferta ha terminado!" },
    { "type": "color", "id": "bg", "label": "Fondo (opcional)" },
    { "type": "text", "id": "button_label", "label": "Botón", "default": "Comprar ahora" },
    { "type": "url", "id": "button_url", "label": "Enlace del botón" }
  ],
  "presets": [{ "name": "Cuenta regresiva" }]
}
{% endschema %}
