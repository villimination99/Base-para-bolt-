{%- liquid
  # LA COPIA, RESUELTA UNA VEZ Y ANTES DE NADA: no solo se pinta,
  # tambien decide, porque media seccion vive dentro de condiciones del
  # tipo "si no esta vacio" y el ajuste va vacio a proposito.
  capture cx_countdown_prefix
    render 'copia', g: 'sec', b: 'announcement-bar', a: 'countdown_prefix', v: section.settings.countdown_prefix
  endcapture
  capture cx_countdown_expired
    render 'copia', g: 'sec', b: 'announcement-bar', a: 'countdown_expired', v: section.settings.countdown_expired
  endcapture
-%}
{%- if section.blocks.size > 0 -%}
  {%- assign show_cd = false -%}
  {%- if section.settings.show_countdown and section.settings.countdown_date != blank -%}{%- assign show_cd = true -%}{%- endif -%}
  <div class="announcement-bar {% if section.settings.scrolling %}announcement-marquee{% endif %}"
       style="background:{{ section.settings.bg }};color:{{ section.settings.text_color }};">
    <div class="announcement-inner">
      {%- if section.settings.scrolling -%}
        <div class="announcement-track">
          {%- for block in section.blocks -%}
            {%- capture cb_msg -%}{%- render 'copia', g: 'sec', b: 'announcement-bar', a: 'text', v: block.settings.text -%}{%- endcapture -%}
            {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}" {{ block.shopify_attributes }}>{{ cb_msg }}</a>{%- else -%}<span {{ block.shopify_attributes }}>{{ cb_msg }}</span>{%- endif -%}
            &nbsp;&nbsp;•&nbsp;&nbsp;
          {%- endfor -%}
        </div>
      {%- else -%}
        {%- assign b = section.blocks | first -%}
        {%- capture cb_msg -%}{%- render 'copia', g: 'sec', b: 'announcement-bar', a: 'text', v: b.settings.text -%}{%- endcapture -%}
        {%- if b.settings.link != blank -%}<a href="{{ b.settings.link }}" {{ b.shopify_attributes }}>{{ cb_msg }}</a>{%- else -%}<span {{ b.shopify_attributes }}>{{ cb_msg }}</span>{%- endif -%}
      {%- endif -%}

      {%- if show_cd -%}
        <span class="announcement-cd" data-countdown="{{ section.settings.countdown_date | escape }}" data-expired="{{ cx_countdown_expired | escape }}">
          {%- if cx_countdown_prefix != blank -%}<span class="announcement-cd-label">{{ cx_countdown_prefix }}</span>{%- endif -%}
          <span class="announcement-cd-time"><b data-cd-days>00</b><i>d</i> <b data-cd-hours>00</b><i>h</i> <b data-cd-mins>00</b><i>m</i> <b data-cd-secs>00</b><i>s</i></span>
        </span>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Barra de anuncios",
  "settings": [
    {
      "type": "paragraph",
      "content": "Los textos de esta seccion viven en los archivos de idioma del tema (locales/*.json, rama \"inicio\"): asi se traducen solos en los cinco idiomas y viajan dentro del zip. Si escribes algo en un campo, lo tuyo manda -- pero en todos los idiomas a la vez. Para cambiar la copia traducida se edita marca/copia-portada.json y se corre node marca/generar-copia.mjs."
    },
    {
      "type": "color",
      "id": "bg",
      "label": "Fondo",
      "default": "#0b0b1e"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Texto",
      "default": "#00d4ff"
    },
    {
      "type": "checkbox",
      "id": "scrolling",
      "label": "Texto en movimiento (marquee)",
      "default": false
    },
    {
      "type": "header",
      "content": "Cuenta atrás (urgencia)"
    },
    {
      "type": "checkbox",
      "id": "show_countdown",
      "label": "Mostrar cuenta atrás",
      "default": false
    },
    {
      "type": "text",
      "id": "countdown_prefix",
      "label": "Texto antes de la cuenta"
    },
    {
      "type": "text",
      "id": "countdown_date",
      "label": "Fecha límite",
      "info": "Formato: AAAA-MM-DD HH:MM (ej. 2026-08-31 23:59)"
    },
    {
      "type": "text",
      "id": "countdown_expired",
      "label": "Texto al terminar"
    }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "Anuncio",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Texto",
          "info": "Déjalo vacío y el aviso se traduce solo en los cinco idiomas."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Enlace"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Barra de anuncios",
      "blocks": [
        {
          "type": "message"
        }
      ]
    }
  ]
}
{% endschema %}
