{%- if section.blocks.size > 0 -%}
  {%- assign show_cd = false -%}
  {%- if section.settings.show_countdown and section.settings.countdown_date != blank -%}{%- assign show_cd = true -%}{%- endif -%}
  <div class="announcement-bar {% if section.settings.scrolling %}announcement-marquee{% endif %}"
       style="background:{{ section.settings.bg }};color:{{ section.settings.text_color }};">
    <div class="announcement-inner">
      {%- if section.settings.scrolling -%}
        <div class="announcement-track">
          {%- for block in section.blocks -%}
            {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}" {{ block.shopify_attributes }}>{{ block.settings.text }}</a>{%- else -%}<span {{ block.shopify_attributes }}>{{ block.settings.text }}</span>{%- endif -%}
            &nbsp;&nbsp;•&nbsp;&nbsp;
          {%- endfor -%}
        </div>
      {%- else -%}
        {%- assign b = section.blocks | first -%}
        {%- if b.settings.link != blank -%}<a href="{{ b.settings.link }}" {{ b.shopify_attributes }}>{{ b.settings.text }}</a>{%- else -%}<span {{ b.shopify_attributes }}>{{ b.settings.text }}</span>{%- endif -%}
      {%- endif -%}

      {%- if show_cd -%}
        <span class="announcement-cd" data-countdown="{{ section.settings.countdown_date | escape }}" data-expired="{{ section.settings.countdown_expired | escape }}">
          {%- if section.settings.countdown_prefix != blank -%}<span class="announcement-cd-label">{{ section.settings.countdown_prefix }}</span>{%- endif -%}
          <span class="announcement-cd-time"><b data-cd-days>00</b><i>d</i> <b data-cd-hours>00</b><i>h</i> <b data-cd-mins>00</b><i>m</i> <b data-cd-secs>00</b><i>s</i></span>
        </span>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Barra de anuncios",
  "settings": [
    { "type": "color", "id": "bg", "label": "Fondo", "default": "#0b0b1e" },
    { "type": "color", "id": "text_color", "label": "Texto", "default": "#00d4ff" },
    { "type": "checkbox", "id": "scrolling", "label": "Texto en movimiento (marquee)", "default": false },
    { "type": "header", "content": "Cuenta atrás (urgencia)" },
    { "type": "checkbox", "id": "show_countdown", "label": "Mostrar cuenta atrás", "default": false },
    { "type": "text", "id": "countdown_prefix", "label": "Texto antes de la cuenta", "default": "Termina en" },
    { "type": "text", "id": "countdown_date", "label": "Fecha límite", "info": "Formato: AAAA-MM-DD HH:MM (ej. 2026-08-31 23:59)" },
    { "type": "text", "id": "countdown_expired", "label": "Texto al terminar", "default": "¡Oferta terminada!" }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "Anuncio",
      "settings": [
        { "type": "text", "id": "text", "label": "Texto", "default": "Envío gratis en pedidos +$50 🚀" },
        { "type": "url", "id": "link", "label": "Enlace" }
      ]
    }
  ],
  "presets": [{ "name": "Barra de anuncios", "blocks": [{ "type": "message" }] }]
}
{% endschema %}
