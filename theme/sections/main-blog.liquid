<section class="section-padding blog-main">
  <div class="container">
    {%- comment -%}
      Migas de pan: orientan al lector y son la ruta que Google muestra bajo el
      título en los resultados.
    {%- endcomment -%}
    <nav class="collection-crumbs" aria-label="breadcrumb">
      <a href="{{ routes.root_url }}">{{ 'general.home' | t }}</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">{{ blog.title }}</span>
    </nav>

    <h1 class="section-title">{{ blog.title }}</h1>
    {%- if section.settings.subtitle != blank -%}
      <p class="section-subtitle blog-subtitle">{{ section.settings.subtitle }}</p>
    {%- endif -%}

    {%- comment -%}
      Cuando se filtra por etiqueta, Shopify sirve /blogs/x/tagged/y. Sin este
      aviso el visitante no sabía por qué veía menos artículos ni cómo volver.
    {%- endcomment -%}
    {%- if current_tags.size > 0 -%}
      <p class="blog-filter">
        {{ 'blogs.general.filter_tag' | t }}
        {%- for t in current_tags -%}<span class="article-tag is-active">{{ t }}</span>{%- endfor -%}
        <a href="{{ blog.url }}" class="customer-link">{{ 'blogs.general.clear_filter' | t }}</a>
      </p>
    {%- elsif section.settings.show_tags and blog.all_tags.size > 0 -%}
      <div class="blog-tags">
        {%- for t in blog.all_tags -%}
          <a href="{{ blog.url }}/tagged/{{ t | handle }}" class="article-tag">{{ t }}</a>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- paginate blog.articles by section.settings.per_page -%}
      {%- comment -%}
        Artículo destacado: el más reciente ocupa el ancho completo en la
        primera página. Da jerarquía a la portada del blog en lugar de una
        rejilla plana donde todo pesa igual.
      {%- endcomment -%}
      {%- assign skip_first = false -%}
      {%- if section.settings.feature_first and paginate.current_page == 1 and current_tags.size == 0 and blog.articles.size > 1 -%}
        {%- assign lead = blog.articles.first -%}
        {%- assign skip_first = true -%}
        <a href="{{ lead.url }}" class="article-lead" {% if settings.enable_scroll_reveal %}data-reveal{% endif %}>
          {%- if lead.image -%}
            <div class="article-lead-media">
              <img src="{{ lead.image | image_url: width: 1400, height: 700, crop: 'center' }}"
                   srcset="{{ lead.image | image_url: width: 600, height: 300, crop: 'center' }} 600w,
                           {{ lead.image | image_url: width: 1000, height: 500, crop: 'center' }} 1000w,
                           {{ lead.image | image_url: width: 1400, height: 700, crop: 'center' }} 1400w"
                   sizes="100vw"
                   alt="{{ lead.title | escape }}" width="1400" height="700" loading="eager" fetchpriority="high">
            </div>
          {%- endif -%}
          <div class="article-lead-body">
            <span class="article-lead-badge">{%- render 'icon', name: 'bolt' -%} {{ 'blogs.general.featured' | t }}</span>
            <h2 class="article-lead-title">{{ lead.title }}</h2>
            <p class="article-lead-excerpt">{{ lead.excerpt_or_content | strip_html | truncatewords: 34 }}</p>
            <span class="article-lead-meta">
              {{ lead.published_at | date: '%d %b, %Y' }}
              {%- assign lead_words = lead.content | strip_html | split: ' ' | size -%}
              {%- assign lead_min = lead_words | divided_by: 200 | plus: 1 -%}
              &middot; {{ 'blogs.article.reading_time' | t: minutes: lead_min }}
            </span>
          </div>
        </a>
      {%- endif -%}

      <div class="article-grid">
        {%- for article in blog.articles -%}
          {%- unless skip_first and forloop.first -%}
            <a href="{{ article.url }}" class="article-card{% if settings.enable_card_tilt %} js-tilt{% endif %}" {% if settings.enable_scroll_reveal %}data-reveal{% endif %}>
              {%- if article.image -%}
                <div class="article-card-media">
                  <img src="{{ article.image | image_url: width: 700, height: 450, crop: 'center' }}"
                       srcset="{{ article.image | image_url: width: 300, height: 193, crop: 'center' }} 300w,
                               {{ article.image | image_url: width: 450, height: 289, crop: 'center' }} 450w,
                               {{ article.image | image_url: width: 700, height: 450, crop: 'center' }} 700w"
                       sizes="(min-width: 861px) 33vw, 100vw" alt="{{ article.title | escape }}" width="700" height="450" loading="lazy">
                </div>
              {%- endif -%}
              <div class="article-card-body">
                <span class="article-card-date">
                  {{ article.published_at | date: '%d %b, %Y' }}
                  {%- assign a_words = article.content | strip_html | split: ' ' | size -%}
                  {%- assign a_min = a_words | divided_by: 200 | plus: 1 -%}
                  &middot; {{ 'blogs.article.reading_time' | t: minutes: a_min }}
                </span>
                <h2 class="article-card-title">{{ article.title }}</h2>
                <p class="article-card-excerpt">{{ article.excerpt_or_content | strip_html | truncatewords: 20 }}</p>
              </div>
            </a>
          {%- endunless -%}
        {%- else -%}
          {%- comment -%} Un blog sin artículos dejaba solo el título y una rejilla vacía. {%- endcomment -%}
          <p class="collection-empty">{{ 'blogs.general.no_articles' | t }}</p>
        {%- endfor -%}
      </div>

      {%- if paginate.pages > 1 -%}
        <nav class="pagination" role="navigation" aria-label="{{ 'general.pagination.label' | t }}">
          {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}" class="pagination-btn">{%- render 'icon', name: 'chevron-up' -%}</a>{%- endif -%}
          {%- for part in paginate.parts -%}
            {%- if part.is_link -%}<a href="{{ part.url }}" class="pagination-num">{{ part.title }}</a>
            {%- else -%}<span class="pagination-num is-current">{{ part.title }}</span>{%- endif -%}
          {%- endfor -%}
          {%- if paginate.next -%}<a href="{{ paginate.next.url }}" class="pagination-btn">{%- render 'icon', name: 'arrow-right' -%}</a>{%- endif -%}
        </nav>
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</section>

{%- comment -%}
  Blog en JSON-LD: le dice a Google (y a los buscadores de IA) que esto es una
  publicación con artículos, no una página suelta, y enlaza cada entrada.
{%- endcomment -%}
{%- if blog.articles.size > 0 -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Blog",
  "@id": {{ shop.url | append: blog.url | append: '#blog' | json }},
  "name": {{ blog.title | json }},
  "url": {{ shop.url | append: blog.url | json }},
  "publisher": { "@id": {{ shop.url | append: '#organization' | json }} },
  "inLanguage": {{ request.locale.iso_code | json }},
  "blogPost": [
    {%- for art in blog.articles limit: 12 -%}
    {
      "@type": "BlogPosting",
      "headline": {{ art.title | json }},
      "url": {{ shop.url | append: art.url | json }},
      "datePublished": {{ art.published_at | date: '%Y-%m-%dT%H:%M:%S%z' | json }}
      {%- if art.image -%},
      "image": {{ art.image | image_url: width: 1200 | prepend: 'https:' | json }}
      {%- endif -%}
    }{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  ]
}
</script>
{%- endif -%}

{% schema %}
{
  "name": "Blog",
  "settings": [
    { "type": "textarea", "id": "subtitle", "label": "Subtítulo", "info": "Una frase que explique de qué va el blog. Ayuda al lector y a los buscadores." },
    { "type": "checkbox", "id": "feature_first", "label": "Destacar el artículo más reciente", "default": true, "info": "El más nuevo ocupa el ancho completo en la primera página." },
    { "type": "checkbox", "id": "show_tags", "label": "Mostrar etiquetas para filtrar", "default": true },
    { "type": "range", "id": "per_page", "min": 6, "max": 24, "step": 3, "label": "Artículos por página", "default": 12 }
  ]
}
{% endschema %}
