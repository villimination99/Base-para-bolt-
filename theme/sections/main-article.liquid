<section class="section-padding article-main">
  <div class="container container--narrow">
    <article>
      <header class="article-header" {% if settings.enable_scroll_reveal %}data-reveal{% endif %}>
        <span class="article-card-date">{{ article.published_at | date: '%d %b, %Y' }}</span>
        <h1 class="section-title">{{ article.title }}</h1>
        {%- if article.author != blank -%}<p class="article-author">{{ 'blogs.article.by' | t }} {{ article.author }}</p>{%- endif -%}
      </header>
      {%- if article.image -%}
        <div class="article-hero-media">
          {%- comment -%}
            height="800" estaba fijo: con imágenes que no fueran 1400x800 el
            navegador reservaba un alto equivocado y la página saltaba (CLS).
          {%- endcomment -%}
          <img src="{{ article.image | image_url: width: 1400 }}"
               srcset="{{ article.image | image_url: width: 600 }} 600w,
                       {{ article.image | image_url: width: 900 }} 900w,
                       {{ article.image | image_url: width: 1400 }} 1400w"
               sizes="(min-width: 1000px) 900px, 100vw"
               alt="{{ article.title | escape }}"
               width="1400" height="{{ 1400 | divided_by: article.image.aspect_ratio | round }}" loading="eager">
        </div>
      {%- endif -%}
      <div class="rte article-content">{{ article.content }}</div>
    </article>

    {%- if blog.comments_enabled? -%}
      <div class="article-comments">
        {%- if article.comments_count > 0 -%}
          <h2>{{ 'blogs.article.comments' | t: count: article.comments_count }}</h2>
          {%- for comment in article.comments -%}
            <div class="comment">
              <p class="comment-body">{{ comment.content }}</p>
              <span class="comment-author">— {{ comment.author }}</span>
            </div>
          {%- endfor -%}
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{ "name": "Artículo", "settings": [] }
{% endschema %}
