<section class="section-padding article-main">
  <div class="container container--narrow">
    <article>
      <header class="article-header" {% if settings.enable_scroll_reveal %}data-reveal{% endif %}>
        <span class="article-card-date">{{ article.published_at | date: '%d %b, %Y' }}</span>
        <h1 class="section-title">{{ article.title }}</h1>
        {%- if article.author != blank -%}<p class="article-author">{{ 'blogs.article.by' | t }} {{ article.author }}</p>{%- endif -%}
      </header>
      {%- if article.image -%}
        <div class="article-hero-media">
          {%- comment -%}
            height="800" estaba fijo: con imágenes que no fueran 1400x800 el
            navegador reservaba un alto equivocado y la página saltaba (CLS).
          {%- endcomment -%}
          <img src="{{ article.image | image_url: width: 1400 }}"
               srcset="{{ article.image | image_url: width: 600 }} 600w,
                       {{ article.image | image_url: width: 900 }} 900w,
                       {{ article.image | image_url: width: 1400 }} 1400w"
               sizes="(min-width: 1000px) 900px, 100vw"
               alt="{{ article.title | escape }}"
               width="1400" height="{{ 1400 | divided_by: article.image.aspect_ratio | round }}" loading="eager">
        </div>
      {%- endif -%}
      <div class="rte article-content">{{ article.content }}</div>
    </article>

    {%- if blog.comments_enabled? -%}
      {%- comment -%}
        El id "comments" es el ancla a la que Shopify devuelve al visitante
        después de enviar un comentario.
      {%- endcomment -%}
      <div class="article-comments" id="comments">
        {%- if article.comments_count > 0 -%}
          <h2>{{ 'blogs.article.comments' | t: count: article.comments_count }}</h2>
          {%- for comment in article.comments -%}
            <div class="comment">
              <p class="comment-body">{{ comment.content }}</p>
              <span class="comment-author">— {{ comment.author }}</span>
            </div>
          {%- endfor -%}
        {%- else -%}
          <p class="comment-none">{{ 'blogs.article.no_comments' | t }}</p>
        {%- endif -%}

        {%- comment -%}
          Faltaba por completo el formulario: los comentarios se mostraban pero
          nadie podía escribir ninguno, así que activar los comentarios en
          Shopify no servía de nada.
        {%- endcomment -%}
        <h2 class="comment-form-title">{{ 'blogs.article.comment_title' | t }}</h2>
        {%- form 'new_comment', article, class: 'customer-form comment-form' -%}
          {%- if form.errors -%}
            <div class="form-errors" role="alert">
              <ul>
                {%- for field in form.errors -%}
                  <li>{{ form.errors.messages[field] }}</li>
                {%- endfor -%}
              </ul>
            </div>
          {%- endif -%}
          {%- if form.posted_successfully? -%}
            <p class="form-success" role="status">
              {%- if blog.moderated? -%}
                {{ 'blogs.article.comment_moderated' | t }}
              {%- else -%}
                {{ 'blogs.article.comment_success' | t }}
              {%- endif -%}
            </p>
          {%- endif -%}
          <label for="CommentAuthor">{{ 'blogs.article.comment_name' | t }}</label>
          <input type="text" name="comment[author]" id="CommentAuthor" autocomplete="name" required value="{{ form.author }}">
          <label for="CommentEmail">{{ 'blogs.article.comment_email' | t }}</label>
          <input type="email" name="comment[email]" id="CommentEmail" autocomplete="email" required value="{{ form.email }}">
          <label for="CommentBody">{{ 'blogs.article.comment_message' | t }}</label>
          <textarea name="comment[body]" id="CommentBody" rows="5" required>{{ form.body }}</textarea>
          <button type="submit" class="btn btn-primary">{{ 'blogs.article.comment_submit' | t }}</button>
        {%- endform -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{ "name": "Artículo", "settings": [] }
{% endschema %}
