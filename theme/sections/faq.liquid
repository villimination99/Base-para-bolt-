{%- liquid
  # LA COPIA, RESUELTA UNA VEZ Y ANTES DE NADA.
  # Tiene que estar arriba del todo porque no solo se pinta: tambien
  # decide. Media seccion vive dentro de una condicion "si no esta
  # vacio", y si
  # esa guarda mirara el ajuste crudo -- que ahora va vacio a proposito,
  # para que mande el idioma -- escondería el texto que si existe.
  capture cx_title
    render 'copia', g: 'sec', b: 'faq', a: 'title', v: section.settings.title
  endcapture
-%}
<section class="section-padding">
  <div class="container">
    <div class="section-head" {% if settings.enable_scroll_reveal %}data-reveal{% endif %}>
      {%- if section.settings.eyebrow != blank -%}<span class="section-eyebrow neon-text-green">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2 class="section-title">{{ cx_title }}</h2>
    </div>

    {%- if section.settings.layout == 'carousel' -%}
      <div class="carousel card-carousel" data-carousel data-autoplay="{{ section.settings.autoplay_speed }}">
        <button class="carousel-arrow carousel-prev" type="button" data-carousel-prev aria-label="{{ 'general.previous' | t }}">{%- render 'icon', name: 'chevron-left' -%}</button>
        <div class="carousel-track" data-carousel-track data-scroll-label="{{ 'accessibility.scrollable_row' | t }}" style="--card-w:340px;">
          {%- for block in section.blocks -%}
            <div class="carousel-slide" {{ block.shopify_attributes }}>
              <div class="faq-card">
                {%- capture q -%}{%- render 'copia', g: 'faq', b: block.id, a: 'question', v: block.settings.question -%}{%- endcapture -%}
      {%- capture a -%}{%- render 'copia', g: 'faq', b: block.id, a: 'answer', v: block.settings.answer -%}{%- endcapture -%}
                <h3 class="faq-card-q">{{ q }}</h3>
                <div class="faq-card-a rte">{{ a }}</div>
              </div>
            </div>
          {%- endfor -%}
        </div>
        <button class="carousel-arrow carousel-next" type="button" data-carousel-next aria-label="{{ 'general.next' | t }}">{%- render 'icon', name: 'chevron-right' -%}</button>
      </div>
    {%- else -%}
      <div class="faq-list">
        {%- for block in section.blocks -%}
          <details class="faq-item" {{ block.shopify_attributes }} {% if forloop.first %}open{% endif %}>
            {%- capture q -%}{%- render 'copia', g: 'faq', b: block.id, a: 'question', v: block.settings.question -%}{%- endcapture -%}
      {%- capture a -%}{%- render 'copia', g: 'faq', b: block.id, a: 'answer', v: block.settings.answer -%}{%- endcapture -%}
            <summary class="faq-q">{{ q }}<span class="nav-caret">{%- render 'icon', name: 'chevron-down' -%}</span></summary>
            <div class="faq-a rte">{{ a }}</div>
          </details>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{%- comment -%}
  FAQPage en JSON-LD. Es lo que hace que Google pueda desplegar las preguntas
  directamente en los resultados, y es de los formatos que mejor entienden los
  buscadores de IA cuando alguien pregunta algo que tú ya respondes aquí.
  La respuesta es richtext, así que se limpia el HTML antes de enviarla.
{%- endcomment -%}
{%- if section.blocks.size > 0 -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {%- for block in section.blocks -%}
      {%- capture q -%}{%- render 'copia', g: 'faq', b: block.id, a: 'question', v: block.settings.question -%}{%- endcapture -%}
      {%- capture a -%}{%- render 'copia', g: 'faq', b: block.id, a: 'answer', v: block.settings.answer -%}{%- endcapture -%}
      {%- if q != blank and a != blank -%}
    {
      "@type": "Question",
      "name": {{ q | strip_html | json }},
      "acceptedAnswer": {
        "@type": "Answer",
        "text": {{ a | strip_html | strip_newlines | json }}
      }
    }{%- unless forloop.last -%},{%- endunless -%}
      {%- endif -%}
    {%- endfor -%}
  ]
}
</script>
{%- endif -%}


{% schema %}
{
  "name": "Preguntas frecuentes",
  "settings": [
    {
      "type": "paragraph",
      "content": "Los textos de esta seccion viven en los archivos de idioma del tema (locales/*.json, rama \"inicio\"), no aqui: asi se traducen solos en los cinco idiomas y viajan dentro del zip. Si escribes algo en un campo, lo tuyo manda -- pero en todos los idiomas a la vez. Para cambiar la copia traducida se edita marca/copia-portada.json y se corre node marca/generar-copia.mjs."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Etiqueta"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Título"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Presentación",
      "options": [
        {
          "value": "carousel",
          "label": "Carrusel de tarjetas"
        },
        {
          "value": "accordion",
          "label": "Acordeón"
        }
      ],
      "default": "carousel"
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "min": 0,
      "max": 10,
      "step": 1,
      "unit": "s",
      "label": "Auto-avance (0 = apagado)",
      "default": 6
    }
  ],
  "blocks": [
    {
      "type": "qa",
      "name": "Pregunta",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Pregunta",
          "default": "¿Cuánto tarda el envío?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Respuesta",
          "default": "<p>Entre 3 y 7 días hábiles.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Preguntas frecuentes",
      "blocks": [
        {
          "type": "qa"
        },
        {
          "type": "qa"
        },
        {
          "type": "qa"
        },
        {
          "type": "qa"
        }
      ]
    }
  ]
}
{% endschema %}
